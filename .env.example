# Psychonaut Log - Variables de Entorno
# Copia este archivo como .env y completa los valores

# Puerto del backend
PORT=3001

# Ruta de la base de datos SQLite
DB_PATH=./data/habits.db

# URL de la API de Ollama (servicio externo)
# Nota: Ollama no funciona en Vercel, usa un servidor externo o API alternativa
OLLAMA_BASE_URL=http://localhost:11434

# Modelo de Ollama para clasificación
OLLAMA_MODEL=llama3

# Modelo de embeddings
OLLAMA_EMBED_MODEL=nomic-embed-text

# URL del servicio de transcription (Python Flask)
# Nota: Despliega el servicio por separado
TRANSCRIPTION_API_URL=http://localhost:5000

# Clave secreta para sesiones (genera una cadena aleatoria segura)
SESSION_SECRET=your-secret-key-here-generate-with-openssl

# Modo de node
NODE_ENV=production