---
import type { Habit } from "../types/habit";

interface Props {
  habits: Habit[];
}

const { habits } = Astro.props;

const today = new Date();
const months: { name: string; year: number; month: number; weeks: { date: string; day: number }[][] }[] = [];

const monthNames = [
  "Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio",
  "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre",
];

const dayNames = ["Lun", "Mar", "Mié", "Jue", "Vie", "Sáb", "Dom"];

for (let i = 2; i >= 0; i--) {
  const d = new Date(today.getFullYear(), today.getMonth() - i, 1);
  const year = d.getFullYear();
  const month = d.getMonth();
  const name = `${monthNames[month]} ${year}`;

  const lastDay = new Date(year, month + 1, 0);
  let startOffset = new Date(year, month, 1).getDay() - 1;
  if (startOffset < 0) startOffset = 6;

  const weeks: { date: string; day: number }[][] = [];
  let week: { date: string; day: number }[] = [];

  for (let dd = 1 - startOffset; dd <= lastDay.getDate(); dd++) {
    if (dd < 1) {
      week.push({ date: "", day: dd });
    } else {
      const date = new Date(year, month, dd);
      week.push({ date: date.toISOString().split("T")[0], day: dd });
    }
    if (week.length === 7) {
      weeks.push(week);
      week = [];
    }
  }
  if (week.length > 0) {
    while (week.length < 7) {
      week.push({ date: "", day: -1 });
    }
    weeks.push(week);
  }

  months.push({ name, year, month, weeks });
}

const maxTotalPerDay = habits.reduce((sum, h) => sum + h.maxPerDay, 0);
---

<div class="calendar-view">
  <div id="calendar-days" data-max-total={maxTotalPerDay}>
    {months.map((m) => (
      <div class="calendar-month">
        <h3 class="month-title">{m.name}</h3>
        <div class="calendar-grid">
          {dayNames.map((dn) => (
            <div class="day-header">{dn}</div>
          ))}
          {m.weeks.map((week) =>
            week.map((d) => {
              const isToday = d.date === today.toISOString().split("T")[0];
              return (
                <div
                  class={`calendar-day ${isToday ? "today" : ""} ${!d.date ? "empty" : ""}`}
                  data-date={d.date}
                >
                  <span class="day-number">{d.day > 0 ? d.day : ""}</span>
                </div>
              );
            })
          )}
        </div>
      </div>
    ))}
  </div>
</div>

<script>
  async function loadCalendarIntensity() {
    try {
      const res = await fetch("/api/logs");
      const logs: { habitId: number; logDate: string; count: number }[] = await res.json();

      const dailyTotals = new Map<string, number>();
      const dailyMax = new Map<string, number>();

      for (const log of logs) {
        if (!dailyTotals.has(log.logDate)) {
          dailyTotals.set(log.logDate, 0);
        }
        dailyTotals.set(log.logDate, dailyTotals.get(log.logDate)! + log.count);
      }

      const maxTotal = Number(document.getElementById("calendar-days")?.getAttribute("data-max-total")) || 1;

      document.querySelectorAll(".calendar-day[data-date]").forEach((day) => {
        const date = day.getAttribute("data-date");
        if (!date) return;
        const total = dailyTotals.get(date) || 0;
        if (total > 0) {
          const intensity = Math.min(total / maxTotal, 1);
          (day as HTMLElement).style.backgroundColor = `rgba(91, 143, 249, ${intensity})`;
        }
      });
    } catch (err) {
      console.error("Failed to load calendar data:", err);
    }
  }

  loadCalendarIntensity();

  document.querySelectorAll(".calendar-day[data-date]").forEach((day) => {
    day.addEventListener("click", () => {
      const date = day.getAttribute("data-date");
      if (!date) return;
      const d = new Date(date + "T00:00:00");
      alert(
        `Resumen del ${d.toLocaleDateString("es-ES", {
          weekday: "long",
          day: "numeric",
          month: "long",
          year: "numeric",
        })}`
      );
    });
  });
</script>

<style>
.calendar-view {
  display: flex;
  flex-direction: column;
  gap: 2rem;
}

.calendar-month {
  background: #0d0d1a;
  border: 1px solid #222;
  border-radius: 12px;
  padding: 1rem;
}

.month-title {
  font-size: 1rem;
  color: #aaa;
  margin: 0 0 0.75rem;
  font-weight: 500;
}

.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 2px;
}

.day-header {
  text-align: center;
  font-size: 0.7rem;
  color: #555;
  padding: 0.3rem 0;
  text-transform: uppercase;
}

.calendar-day {
  aspect-ratio: 1;
  border-radius: 4px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: transform 0.1s, outline 0.1s;
  min-height: 32px;
}

.calendar-day:not(.empty):hover {
  transform: scale(1.15);
  outline: 1px solid rgba(255, 255, 255, 0.3);
  outline-offset: -1px;
}

.calendar-day.empty {
  cursor: default;
  background: transparent !important;
}

.calendar-day.today {
  outline: 1px solid #5b8ff9;
  outline-offset: -1px;
}

.day-number {
  font-size: 0.75rem;
  color: #888;
}
</style>
