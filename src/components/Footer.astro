---
const year = new Date().getFullYear();
---
<footer class="site-footer" role="contentinfo">
  <div class="footer-cont">
    <p>&copy; {year} creado por Juan Robledo.</p>
  </div>
</footer>

<style>
  .site-footer {
    background:linear-gradient( to bottom, rgba(0,0,0,0.8), rgba(1,2,7,0)), url('/images/brain2.webp');
    background-size: cover;
    background-position: top;
    min-height: 200px;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 2rem 1rem;
  }

  .footer-cont {
    text-align: center;
    color: #fefefe;
    font-size: 0.9rem;
  }

  .footer-cont p {
    margin: 0;
  }
</style>