---
import type { Habit } from "../types/habit";
import { getDatesArray } from "../lib/dates";

interface Props {
  habits: Habit[];
}

const { habits } = Astro.props;

const dates = getDatesArray();

function getMonthLabel(dateStr: string): string {
  const d = new Date(dateStr + "T00:00:00");
  const months = ["Ene", "Feb", "Mar", "Abr", "May", "Jun", "Jul", "Ago", "Sep", "Oct", "Nov", "Dic"];
  return `${months[d.getMonth()]} ${d.getDate()}`;
}
---

<div class="grid-wrapper">
  <div class="grid-scroll">
    <table class="habit-grid">
      <thead>
        <tr>
          <th class="label-col"></th>
          {dates.map((date, i) => {
            const d = new Date(date + "T00:00:00");
            const showLabel = i === 0 || d.getDate() === 1 || d.getDate() === 15;
            return <th class="date-col">
              <span class="date-label" data-date={date}>
                {showLabel ? getMonthLabel(date) : ""}
              </span>
            </th>;
          })}
        </tr>
      </thead>
      <tbody>
        {habits.map((habit) => (
          <tr>
            <td class="label-col">
              <span class="habit-name" style={`color:${habit.color}`}>{habit.name}</span>
            </td>
            {dates.map((date) => (
              <td>
                <div
                  class="cell"
                  data-habit={habit.id}
                  data-date={date}
                  data-max={habit.maxPerDay}
                  style={`background-color:${habit.color};`
                }></div>
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>

<script>
  function getAuthHeaders(): Record<string, string> {
    const token = localStorage.getItem("psy_token");
    return token ? { Authorization: `Bearer ${token}` } : {};
  }

  async function loadLogs() {
    try {
      const res = await fetch("/api/logs", { headers: getAuthHeaders() });
      const logs: { habitId: number; logDate: string; count: number }[] = await res.json();

      const logMap = new Map<string, number>();
      for (const log of logs) {
        logMap.set(`${log.habitId}:${log.logDate}`, log.count);
      }

      document.querySelectorAll(".cell").forEach((cell) => {
        const habitId = cell.getAttribute("data-habit");
        const date = cell.getAttribute("data-date");
        const max = Number(cell.getAttribute("data-max")) || 1;
        if (!habitId || !date) return;

        const count = logMap.get(`${habitId}:${date}`) || 0;
        if (count > 0) {
          const opacity = Math.min(count / max, 1);
          cell.style.opacity = String(opacity);
        }
      });
    } catch (err) {
      console.error("Failed to load logs:", err);
    }
  }

  document.querySelectorAll(".cell").forEach((cell) => {
    cell.addEventListener("click", async () => {
      const habitId = cell.getAttribute("data-habit");
      const date = cell.getAttribute("data-date");
      if (!habitId || !date) return;

      const token = localStorage.getItem("psy_token");
      const headers: Record<string, string> = { "Content-Type": "application/json" };
      if (token) headers["Authorization"] = `Bearer ${token}`;

      try {
        await fetch("/api/log", {
          method: "POST",
          headers,
          body: JSON.stringify({ habitId: Number(habitId), date }),
        });

        const res = await fetch("/api/logs", { headers });
        const logs: { habitId: number; logDate: string; count: number }[] = await res.json();

        const logMap = new Map<string, number>();
        for (const log of logs) {
          logMap.set(`${log.habitId}:${log.logDate}`, log.count);
        }

        const max = Number(cell.getAttribute("data-max")) || 1;
        const count = logMap.get(`${habitId}:${date}`) || 0;
        if (count > 0) {
          const opacity = Math.min(count / max, 1);
          cell.style.opacity = String(opacity);
        }
      } catch (err) {
        console.error("Error logging habit:", err);
      }
    });

    cell.addEventListener("mouseenter", () => {
      const date = cell.getAttribute("data-date");
      if (date) {
        const d = new Date(date + "T00:00:00");
        cell.title = d.toLocaleDateString("es-ES", {
          weekday: "short",
          day: "numeric",
          month: "short",
        });
      }
    });
  });

  loadLogs();
</script>

<style>
.grid-wrapper {
  overflow-x: auto;
  border-radius: 12px;
  border: 1px solid #222;
  background: #0d0d1a;
}

.grid-scroll {
  display: inline-block;
  min-width: 100%;
}

.habit-grid {
  border-collapse: collapse;
  width: auto;
}

.habit-grid th,
.habit-grid td {
  padding: 0;
  border: none;
}

.label-col {
  position: sticky;
  left: 0;
  background: #0d0d1a;
  z-index: 2;
  padding: 0.5rem 0.75rem !important;
  min-width: 120px;
}

.habit-name {
  font-size: 0.85rem;
  font-weight: 600;
  white-space: nowrap;
}

.date-col {
  padding: 0 !important;
  text-align: center;
}

.date-label {
  display: block;
  font-size: 0.65rem;
  color: #666;
  padding: 0.4rem 0;
  white-space: nowrap;
}

.cell {
  width: 14px;
  height: 14px;
  cursor: pointer;
  opacity: 0;
  transition: transform 0.1s;
  margin: 1px;
}

.cell:hover {
  transform: scale(1.4);
  outline: 1px solid #fff;
  outline-offset: -1px;
}

.habit-grid thead th:first-child {
  background: #0d0d1a;
}
</style>
