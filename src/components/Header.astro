---
import psychonautIcon from '../assets/psychonaut_log-icon.png?url';
---

<header class="site-header">
  <div class="header-container">
    <a href="/" class="logo" aria-label="Psychonaut Log - Inicio">
      <img src={psychonautIcon} alt="" width="40" height="40" />
      <span class="logo-text">PsychonautLog</span>
    </a>
    
    <button 
      class="menu-toggle" 
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
      aria-controls="main-nav"
    >
      <span class="hamburger"></span>
    </button>
    
    <nav id="main-nav" class="main-nav" aria-label="Navegación principal">
      <ul class="nav-list" role="list">
        <!-- <li><a href="/">Home</a></li> -->
        <li><a href="/practica">Nueva entrada</a></li>
        <li><a href="/habits">Hábitos tracker</a></li>
        <li><a href="/journal">Bitácora</a></li>
        <li><a href="/clasificador">Clasificador</a></li>
        <!-- <li><a href="/about">About</a></li> -->
        <!-- <li><a href="/contact">Contact</a></li> -->
        <li id="admin-nav-link" hidden><a href="/admin">Admin</a></li>
      </ul>
      <div class="auth-section">
        <button id="login-btn" class="btn-login">Iniciar Sesión</button>
      </div>
    </nav>
  </div>
</header>

<div id="login-modal" class="modal" role="dialog" aria-modal="true" aria-labelledby="login-title" hidden>
  <div class="modal-content">
    <button id="close-modal" class="modal-close" aria-label="Cerrar">&times;</button>
    <h2 id="login-title">Iniciar Sesión</h2>
    <form id="login-form">
      <div class="form-group">
        <label for="username">Usuario</label>
        <input type="text" id="username" name="username" required autocomplete="username" />
      </div>
      <div class="form-group">
        <label for="password">Contraseña</label>
        <input type="password" id="password" name="password" required autocomplete="current-password" />
      </div>
      <div id="login-error" class="error-msg" hidden></div>
      <button type="submit" class="btn-submit">Entrar</button>
    </form>
    <div class="demo-users">
      <p>Usuarios de prueba:</p>
      <code>jera / psicologo / admin / invitado</code>
      <p class="hint">Contraseña: psy2024</p>
    </div>
  </div>
</div>

<div id="password-modal" class="modal" role="dialog" aria-modal="true" aria-labelledby="pass-title" hidden>
  <div class="modal-content">
    <button id="close-pass-modal" class="modal-close" aria-label="Cerrar">&times;</button>
    <h2 id="pass-title">Cambiar Contraseña</h2>
    <form id="password-form">
      <div class="form-group">
        <label for="current-password">Contraseña actual</label>
        <input type="password" id="current-password" name="currentPassword" required />
      </div>
      <div class="form-group">
        <label for="new-password">Nueva contraseña</label>
        <input type="password" id="new-password" name="newPassword" required minlength="4" />
      </div>
      <div id="pass-error" class="error-msg" hidden></div>
      <div id="pass-success" class="success-msg" hidden>Contraseña actualizada correctamente</div>
      <button type="submit" class="btn-submit">Guardar</button>
    </form>
  </div>
</div>

<div id="user-menu" class="user-menu" hidden>
  <span id="user-display"></span>
  <button id="change-pass-btn" class="btn-secondary">Cambiar clave</button>
  <button id="logout-btn" class="btn-logout">Cerrar Sesión</button>
</div>

<script>
  const toggle = document.querySelector('.menu-toggle');
  const nav = document.querySelector('.main-nav');
  
  toggle?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('open');
    toggle.setAttribute('aria-expanded', String(isOpen));
    toggle.classList.toggle('active');
  });
  
  document.addEventListener('click', (e) => {
    if (!nav?.contains(e.target as Node) && !toggle?.contains(e.target as Node)) {
      nav?.classList.remove('open');
      toggle?.classList.remove('active');
      toggle?.setAttribute('aria-expanded', 'false');
    }
  });

  const TOKEN_KEY = 'psy_token';
  const USER_KEY = 'psy_user';

  const loginBtn = document.getElementById('login-btn') as HTMLButtonElement;
  const logoutBtn = document.getElementById('logout-btn') as HTMLButtonElement;
  const loginModal = document.getElementById('login-modal') as HTMLDivElement;
  const closeModal = document.getElementById('close-modal') as HTMLButtonElement;
  const loginForm = document.getElementById('login-form') as HTMLFormElement;
  const loginError = document.getElementById('login-error') as HTMLDivElement;
  const userMenu = document.getElementById('user-menu') as HTMLDivElement;
  const userDisplay = document.getElementById('user-display') as HTMLSpanElement;

  function getApiBase(): string {
    const meta = document.querySelector('meta[name="api-base"]');
    return meta ? meta.getAttribute('content') || '' : 'http://localhost:3001';
  }

  function getToken(): string | null {
    return localStorage.getItem(TOKEN_KEY);
  }

  function setToken(token: string) {
    localStorage.setItem(TOKEN_KEY, token);
  }

  function setUser(user: { id: number; username: string; role: string }) {
    localStorage.setItem(USER_KEY, JSON.stringify(user));
  }

  function getUser(): { id: number; username: string; role: string } | null {
    const u = localStorage.getItem(USER_KEY);
    return u ? JSON.parse(u) : null;
  }

  function clearAuth() {
    localStorage.removeItem(TOKEN_KEY);
    localStorage.removeItem(USER_KEY);
  }

  function updateAuthUI() {
    const user = getUser();
    const token = getToken();
    const adminLink = document.getElementById('admin-nav-link') as HTMLLIElement;
    if (user && token) {
      loginBtn.hidden = true;
      userMenu.hidden = false;
      userDisplay.textContent = `${user.username} (${user.role})`;
      if (adminLink) adminLink.hidden = user.role !== 'admin';
    } else {
      loginBtn.hidden = false;
      userMenu.hidden = true;
      if (adminLink) adminLink.hidden = true;
    }
  }

  async function checkSession() {
    const token = getToken();
    if (!token) return updateAuthUI();
    try {
      const res = await fetch(`${getApiBase()}/api/auth/me`, {
        headers: { Authorization: `Bearer ${token}` }
      });
      if (res.ok) {
        const data = await res.json();
        setUser(data.user);
      } else {
        clearAuth();
      }
    } catch {
      clearAuth();
    }
    updateAuthUI();
  }

  loginBtn?.addEventListener('click', () => {
    loginModal.hidden = false;
    loginError.hidden = true;
    (document.getElementById('username') as HTMLInputElement).focus();
  });

  closeModal?.addEventListener('click', () => {
    loginModal.hidden = true;
  });

  loginModal?.addEventListener('click', (e) => {
    if (e.target === loginModal) loginModal.hidden = true;
  });

  loginForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const username = (document.getElementById('username') as HTMLInputElement).value;
    const password = (document.getElementById('password') as HTMLInputElement).value;
    loginError.hidden = true;
    try {
      const res = await fetch(`${getApiBase()}/api/auth/login`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ username, password })
      });
      const data = await res.json();
      if (!res.ok) {
        loginError.textContent = data.error || 'Error de autenticación';
        loginError.hidden = false;
        return;
      }
      setToken(data.token);
      setUser(data.user);
      loginModal.hidden = true;
      updateAuthUI();
      location.reload();
    } catch (err) {
      loginError.textContent = 'Error de conexión';
      loginError.hidden = false;
    }
  });

  logoutBtn?.addEventListener('click', async () => {
    const token = getToken();
    if (token) {
      await fetch(`${getApiBase()}/api/auth/logout`, {
        method: 'POST',
        headers: { Authorization: `Bearer ${token}` }
      }).catch(() => {});
    }
    clearAuth();
    updateAuthUI();
    location.reload();
  });

  const passModal = document.getElementById('password-modal') as HTMLDivElement;
  const changePassBtn = document.getElementById('change-pass-btn') as HTMLButtonElement;
  const closePassBtn = document.getElementById('close-pass-modal') as HTMLButtonElement;
  const passForm = document.getElementById('password-form') as HTMLFormElement;
  const passError = document.getElementById('pass-error') as HTMLDivElement;
  const passSuccess = document.getElementById('pass-success') as HTMLDivElement;

  changePassBtn?.addEventListener('click', () => {
    passError.hidden = true;
    passSuccess.hidden = true;
    passModal.hidden = false;
  });

  closePassBtn?.addEventListener('click', () => {
    passModal.hidden = true;
  });

  passModal?.addEventListener('click', (e) => {
    if (e.target === passModal) passModal.hidden = true;
  });

  passForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    passError.hidden = true;
    passSuccess.hidden = true;
    const currentPassword = (document.getElementById('current-password') as HTMLInputElement).value;
    const newPassword = (document.getElementById('new-password') as HTMLInputElement).value;
    const token = getToken();
    if (!token) return;
    try {
      const res = await fetch(`${getApiBase()}/api/auth/change-password`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Authorization: `Bearer ${token}`
        },
        body: JSON.stringify({ currentPassword, newPassword })
      });
      const data = await res.json();
      if (!res.ok) {
        passError.textContent = data.error || 'Error al cambiar contraseña';
        passError.hidden = false;
        return;
      }
      passSuccess.hidden = false;
      setTimeout(() => { passModal.hidden = true; }, 1500);
    } catch {
      passError.textContent = 'Error de conexión';
      passError.hidden = false;
    }
  });

  document.addEventListener('DOMContentLoaded', checkSession);
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(1, 2, 7, 0.95);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid #2a2a35;
  }

  .header-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0.75rem 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: #fefefe;
  }

  .logo img {
    width: 40px;
    height: 40px;
    border-radius: 8px;
  }

  .logo-text {
    font-weight: 700;
    font-size: 1.1rem;
  }

  .menu-toggle {
    display: none;
    background: transparent;
    border: none;
    padding: 0.5rem;
    cursor: pointer;
    z-index: 101;
  }

  .hamburger {
    display: block;
    width: 24px;
    height: 2px;
    background: #fefefe;
    position: relative;
    transition: background 0.2s;
  }

  .hamburger::before,
  .hamburger::after {
    content: '';
    position: absolute;
    width: 24px;
    height: 2px;
    background: #fefefe;
    transition: transform 0.2s;
  }

  .hamburger::before {
    top: -8px;
  }

  .hamburger::after {
    bottom: -8px;
  }

  .menu-toggle.active .hamburger {
    background: transparent;
  }

  .menu-toggle.active .hamburger::before {
    transform: rotate(45deg) translate(5px, 6px);
  }

  .menu-toggle.active .hamburger::after {
    transform: rotate(-45deg) translate(5px, -6px);
  }

  .main-nav {
    flex: 1;
    display: flex;
    justify-content: flex-end;
  }

  .nav-list {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
    justify-content: center;
  }

  .nav-list a {
    display: block;
    padding: 0.5rem 1rem;
    color: #aaa;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    border-radius: 8px;
    transition: all 0.2s;
  }

  .nav-list a:hover,
  .nav-list a:focus {
    color: #fefefe;
    background: rgba(255, 255, 255, 0.05);
  }

  .nav-list a:focus-visible {
    outline: 2px solid #5b8ff9;
    outline-offset: 2px;
  }

  .auth-section {
    display: flex;
    align-items: center;
  }

  .btn-login {
    background: #5b8ff9;
    color: #fff;
    border: none;
    padding: 0.5rem 1.25rem;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
  }

  .btn-login:hover {
    background: #4a7de0;
  }

  .user-menu {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  #user-display {
    color: #aaa;
    font-size: 0.9rem;
  }

  .btn-logout {
    background: transparent;
    color: #ef4444;
    border: 1px solid #ef4444;
    padding: 0.35rem 0.75rem;
    border-radius: 6px;
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn-logout:hover {
    background: #ef4444;
    color: #fff;
  }

  .btn-secondary {
    background: transparent;
    color: #aaa;
    border: 1px solid #3a3a4e;
    padding: 0.35rem 0.75rem;
    border-radius: 6px;
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn-secondary:hover {
    color: #fefefe;
    border-color: #5b8ff9;
  }

  .modal {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.7);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 200;
    backdrop-filter: blur(4px);
  }

  .modal[hidden] {
    display: none;
  }

  .modal-content {
    background: #1a1a2e;
    border: 1px solid #2a2a3e;
    border-radius: 16px;
    padding: 2rem;
    width: 100%;
    max-width: 400px;
    position: relative;
  }

  .modal-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: transparent;
    border: none;
    color: #aaa;
    font-size: 1.5rem;
    cursor: pointer;
    line-height: 1;
  }

  .modal-close:hover {
    color: #fff;
  }

  .modal-content h2 {
    margin: 0 0 1.5rem;
    color: #fefefe;
    font-size: 1.5rem;
  }

  .form-group {
    margin-bottom: 1rem;
  }

  .form-group label {
    display: block;
    color: #aaa;
    font-size: 0.9rem;
    margin-bottom: 0.4rem;
  }

  .form-group input {
    width: 100%;
    padding: 0.65rem 0.85rem;
    background: #0f0f1a;
    border: 1px solid #2a2a3e;
    border-radius: 8px;
    color: #fefefe;
    font-size: 1rem;
    box-sizing: border-box;
  }

  .form-group input:focus {
    outline: none;
    border-color: #5b8ff9;
  }

  .error-msg {
    color: #ef4444;
    font-size: 0.85rem;
    margin-bottom: 0.75rem;
  }

  .error-msg[hidden] {
    display: none;
  }

  .success-msg {
    color: #22c55e;
    font-size: 0.85rem;
    margin-bottom: 0.75rem;
    text-align: center;
  }

  .success-msg[hidden] {
    display: none;
  }

  .btn-submit {
    width: 100%;
    padding: 0.75rem;
    background: #5b8ff9;
    color: #fff;
    border: none;
    border-radius: 8px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
  }

  .btn-submit:hover {
    background: #4a7de0;
  }

  .demo-users {
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid #2a2a3e;
    text-align: center;
  }

  .demo-users p {
    color: #888;
    font-size: 0.85rem;
    margin: 0.25rem 0;
  }

  .demo-users code {
    color: #5b8ff9;
    font-size: 0.9rem;
  }

  .demo-users .hint {
    color: #666;
    font-size: 0.8rem;
  }

  @media (max-width: 768px) {
    .menu-toggle {
      display: block;
    }

    .main-nav {
      position: fixed;
      top: 0;
      right: 0;
      bottom: 0;
      width: 280px;
      background: rgba(17, 24, 39, 0.98);
      border-left: 1px solid #2a2a35;
      transform: translateX(100%);
      transition: transform 0.3s ease;
      padding-top: 5rem;
      backdrop-filter: blur(10px);
    }

    .main-nav.open {
      transform: translateX(0);
    }

    .nav-list {
      display: flex !important;
      flex-direction: column !important;
      flex-wrap: nowrap !important;
      gap: 0 !important;
      padding: 0.5rem;
      width: 100% !important;
    }

    .nav-list li {
      width: 100% !important;
      display: flex !important;
      flex-direction: column !important;
    }

    .nav-list a {
      display: flex !important;
      width: 100% !important;
      padding: 1rem;
      font-size: 1.1rem;
      border-radius: 10px;
      text-align: left;
      box-sizing: border-box;
      color: #f3f4f6;
      background: transparent;
    }

    .nav-list a:hover,
    .nav-list a:focus {
      background: rgba(255, 255, 255, 0.1);
      color: #fefefe;
    }

    .logo-text {
      display: none;
    }
  }
</style>