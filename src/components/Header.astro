---
import LogoImg from '../assets/Logo.png';
---

<header class="site-header" id="site-header">
  <div class="header-container">
    <a href="/" class="logo" aria-label="Psychonaut Log - Inicio">
      <img src={LogoImg.src} alt="Psychonaut Log" width="60" height="60" />
    </a>
    
    <nav id="main-nav" class="main-nav" aria-label="Navegación principal">
      <ul class="nav-list" role="list">
        <li><a href="/practica">Nueva entrada</a></li>
        <li><a href="/habits">Hábitos</a></li>
        <li><a href="/journal">Bitácora</a></li>
        <li id="practica-guiada-link" hidden><a href="/practica_guiada">Guía</a></li>
        <li id="admin-nav-link" hidden><a href="/admin">Admin</a></li>
      </ul>
      
    </nav>
    
    <div class="header-profile">
      <button id="login-btn" class="btn-login" hidden>Iniciar Sesión</button>
      <button id="profile-btn" class="profile-btn" aria-label="Abrir menú de perfil" hidden>
        <div class="avatar" id="user-avatar">
          <span class="avatar-init" id="avatar-init">?</span>
        </div>
      </button>
      
      <div id="profile-dropdown" class="profile-dropdown" hidden>
        <div class="dropdown-backdrop"></div>
        <div class="dropdown-content">
          <div class="dropdown-header">
            <div class="user-info">
              <span class="user-name" id="dropdown-username">Invitado</span>
              <span class="user-role" id="dropdown-role"></span>
            </div>
          </div>
          <div class="dropdown-divider"></div>
          <button id="change-pass-btn" class="dropdown-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            Cambiar clave
          </button>
          <button id="logout-btn" class="dropdown-item dropdown-item-danger">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
              <polyline points="16 17 21 12 16 7"></polyline>
              <line x1="21" y1="12" x2="9" y2="12"></line>
            </svg>
            Cerrar Sesión
          </button>
        </div>
      </div>
    </div>
  </div>
</header>

<div id="mobile-sheet" class="mobile-sheet" hidden>
  <div class="sheet-backdrop"></div>
  <div class="sheet-content">
    <div class="sheet-handle"></div>
    <div class="sheet-header">
      <div class="sheet-avatar" id="sheet-avatar">
        <span class="avatar-init" id="sheet-avatar-init">?</span>
      </div>
      <div class="sheet-user-info">
        <span class="sheet-username" id="sheet-username">Invitado</span>
        <span class="sheet-role" id="sheet-role"></span>
      </div>
    </div>
    <div class="sheet-divider"></div>
    <button id="sheet-change-pass" class="sheet-item">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
      </svg>
      Cambiar clave
    </button>
    <button id="sheet-logout" class="sheet-item sheet-item-danger">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
        <polyline points="16 17 21 12 16 7"></polyline>
        <line x1="21" y1="12" x2="9" y2="12"></line>
      </svg>
      Cerrar Sesión
    </button>
    <div class="sheet-divider"></div>
    <a href="/settings" class="sheet-item">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="12" cy="12" r="3"></circle>
        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
      </svg>
      Configuración
    </a>
  </div>
</div>

<div id="login-modal" class="modal" role="dialog" aria-modal="true" aria-labelledby="login-title" hidden>
  <div class="modal-content">
    <button id="close-modal" class="modal-close" aria-label="Cerrar">&times;</button>
    <h2 id="login-title">Iniciar Sesión</h2>
    <form id="login-form">
      <div class="form-group">
        <label for="username">Usuario</label>
        <input type="text" id="username" name="username" required autocomplete="username" />
      </div>
      <div class="form-group">
        <label for="password">Contraseña</label>
        <input type="password" id="password" name="password" required autocomplete="current-password" />
      </div>
      <div id="login-error" class="error-msg" hidden></div>
      <button type="submit" class="btn-submit">Entrar</button>
    </form>
  </div>
</div>

<div id="password-modal" class="modal" role="dialog" aria-modal="true" aria-labelledby="pass-title" hidden>
  <div class="modal-content">
    <button id="close-pass-modal" class="modal-close" aria-label="Cerrar">&times;</button>
    <h2 id="pass-title">Cambiar Contraseña</h2>
    <form id="password-form">
      <div class="form-group">
        <label for="current-password">Contraseña actual</label>
        <input type="password" id="current-password" name="currentPassword" required />
      </div>
      <div class="form-group">
        <label for="new-password">Nueva contraseña</label>
        <input type="password" id="new-password" name="newPassword" required minlength="4" />
      </div>
      <div id="pass-error" class="error-msg" hidden></div>
      <div id="pass-success" class="success-msg" hidden>Contraseña actualizada correctamente</div>
      <button type="submit" class="btn-submit">Guardar</button>
    </form>
  </div>
</div>

<script>
  const TOKEN_KEY = 'psy_token';
  const USER_KEY = 'psy_user';

  // ── Scroll hide/show header ──────────────────────────────
  function initScrollHeader() {
    const siteHeader = document.getElementById('site-header');
    if (!siteHeader) { console.log('[Header] header not found'); return; }
    let lastScrollY = 0;
    let ticking = false;

    console.log('[Header] siteHeader:', siteHeader, 'scrollY:', window.scrollY);

    function onScroll() {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          const currentScrollY = window.scrollY;
          console.log('[Header] scroll:', currentScrollY, 'last:', lastScrollY);
          if (currentScrollY > lastScrollY && currentScrollY > 80) {
            siteHeader.style.transform = 'translateY(-100%)';
            siteHeader.style.transition = 'transform 0.3s';
            console.log('[Header] HIDDEN');
          } else {
            siteHeader.style.transform = '';
            console.log('[Header] SHOWN');
          }
          lastScrollY = currentScrollY;
          ticking = false;
        });
        ticking = true;
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    console.log('[Header] scroll listener attached');
  }

  initScrollHeader();
  // ── End scroll logic ─────────────────────────────────────

  function getApiBase(): string {
    return '';
  }

  function getToken(): string | null {
    return localStorage.getItem(TOKEN_KEY);
  }

  function setToken(token: string) {
    localStorage.setItem(TOKEN_KEY, token);
  }

  function setUser(user: { id: number; username: string; role: string }) {
    localStorage.setItem(USER_KEY, JSON.stringify(user));
  }

  function getUser(): { id: number; username: string; role: string } | null {
    const u = localStorage.getItem(USER_KEY);
    return u ? JSON.parse(u) : null;
  }

  function clearAuth() {
    localStorage.removeItem(TOKEN_KEY);
    localStorage.removeItem(USER_KEY);
  }

  function getInitials(username: string): string {
    return username.charAt(0).toUpperCase();
  }

  function updateAvatars(username: string, role: string) {
    const initials = getInitials(username);
    const elements = ['avatar-init', 'sheet-avatar-init'];
    elements.forEach(id => {
      const el = document.getElementById(id);
      if (el) el.textContent = initials;
    });

    const userElements = [
      { name: 'dropdown-username', role: 'dropdown-role' },
      { name: 'sheet-username', role: 'sheet-role' }
    ];
    userElements.forEach(({ name, role: roleId }) => {
      const nameEl = document.getElementById(name);
      const roleEl = document.getElementById(roleId);
      if (nameEl) nameEl.textContent = username;
      if (roleEl) roleEl.textContent = role;
    });
  }

  function updateAuthUI() {
    const user = getUser();
    const token = getToken();
    const adminLink = document.getElementById('admin-nav-link') as HTMLLIElement;
    const practicaGuiadaLink = document.getElementById('practica-guiada-link') as HTMLLIElement;
    const loginBtn = document.getElementById('login-btn') as HTMLButtonElement;
    const profileBtn = document.getElementById('profile-btn') as HTMLButtonElement;
    
    if (user && token) {
      loginBtn.hidden = true;
      profileBtn.hidden = false;
      updateAvatars(user.username, user.role);
      if (adminLink) adminLink.hidden = user.role !== 'admin';
      if (practicaGuiadaLink) practicaGuiadaLink.hidden = false;
    } else {
      loginBtn.hidden = false;
      profileBtn.hidden = true;
      updateAvatars('Invitado', '');
      if (adminLink) adminLink.hidden = true;
      if (practicaGuiadaLink) practicaGuiadaLink.hidden = true;
    }
  }

  async function checkSession() {
    const token = getToken();
    if (!token) return updateAuthUI();
    try {
      const res = await fetch(`${getApiBase()}/api/auth/me`, {
        headers: { Authorization: `Bearer ${token}` }
      });
      if (res.ok) {
        const data = await res.json();
        setUser(data.user);
      } else {
        clearAuth();
      }
    } catch {
      clearAuth();
    }
    updateAuthUI();
  }

  // Mobile sheet
  const profileBtn = document.getElementById('profile-btn');
  const mobileSheet = document.getElementById('mobile-sheet');
  const sheetBackdrop = mobileSheet?.querySelector('.sheet-backdrop') as HTMLElement;
  
  profileBtn?.addEventListener('click', () => {
    const isMobile = window.innerWidth < 768;
    if (isMobile) {
      mobileSheet.hidden = false;
      document.body.style.overflow = 'hidden';
    }
  });

  function closeSheet() {
    mobileSheet.hidden = true;
    document.body.style.overflow = '';
  }

  sheetBackdrop?.addEventListener('click', closeSheet);

  // Desktop dropdown
  const dropdown = document.getElementById('profile-dropdown');
  const dropdownBackdrop = dropdown?.querySelector('.dropdown-backdrop') as HTMLElement;
  
  profileBtn?.addEventListener('mouseenter', () => {
    const isDesktop = window.innerWidth >= 768;
    if (isDesktop && getToken()) {
      dropdown.hidden = false;
    }
  });

  dropdown?.addEventListener('mouseleave', () => {
    dropdown.hidden = true;
  });

  dropdownBackdrop?.addEventListener('click', () => {
    dropdown.hidden = true;
  });

  // Login modal
  const loginBtn = document.getElementById('login-btn') as HTMLButtonElement;
  const loginModal = document.getElementById('login-modal') as HTMLDivElement;
  const closeModal = document.getElementById('close-modal') as HTMLButtonElement;
  const loginForm = document.getElementById('login-form') as HTMLFormElement;
  const loginError = document.getElementById('login-error') as HTMLDivElement;

  loginBtn?.addEventListener('click', () => {
    loginModal.hidden = false;
    loginError.hidden = true;
    (document.getElementById('username') as HTMLInputElement).focus();
  });

  closeModal?.addEventListener('click', () => {
    loginModal.hidden = true;
  });

  loginModal?.addEventListener('click', (e) => {
    if (e.target === loginModal) loginModal.hidden = true;
  });

  loginForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const username = (document.getElementById('username') as HTMLInputElement).value;
    const password = (document.getElementById('password') as HTMLInputElement).value;
    loginError.hidden = true;
    try {
      const res = await fetch(`${getApiBase()}/api/auth/login`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ username, password })
      });
      const data = await res.json();
      if (!res.ok) {
        loginError.textContent = data.error || 'Error de autenticación';
        loginError.hidden = false;
        return;
      }
      setToken(data.token);
      setUser(data.user);
      loginModal.hidden = true;
      updateAuthUI();
      window.location.href = '/inicio';
    } catch (err) {
      loginError.textContent = 'Error de conexión';
      loginError.hidden = false;
    }
  });

  // Logout buttons
  const logoutBtn = document.getElementById('logout-btn') as HTMLButtonElement;
  const sheetLogout = document.getElementById('sheet-logout') as HTMLButtonElement;

  async function handleLogout() {
    const token = getToken();
    if (token) {
      await fetch(`${getApiBase()}/api/auth/logout`, {
        method: 'POST',
        headers: { Authorization: `Bearer ${token}` }
      }).catch(() => {});
    }
    clearAuth();
    updateAuthUI();
    closeSheet();
  }

  logoutBtn?.addEventListener('click', handleLogout);
  sheetLogout?.addEventListener('click', handleLogout);

  // Password modal
  const passModal = document.getElementById('password-modal') as HTMLDivElement;
  const changePassBtn = document.getElementById('change-pass-btn') as HTMLButtonElement;
  const sheetChangePass = document.getElementById('sheet-change-pass') as HTMLButtonElement;
  const closePassBtn = document.getElementById('close-pass-modal') as HTMLButtonElement;
  const passForm = document.getElementById('password-form') as HTMLFormElement;
  const passError = document.getElementById('pass-error') as HTMLDivElement;
  const passSuccess = document.getElementById('pass-success') as HTMLDivElement;

  function openPassModal() {
    passError.hidden = true;
    passSuccess.hidden = true;
    passModal.hidden = false;
    closeSheet();
  }

  changePassBtn?.addEventListener('click', openPassModal);
  sheetChangePass?.addEventListener('click', openPassModal);

  closePassBtn?.addEventListener('click', () => {
    passModal.hidden = true;
  });

  passModal?.addEventListener('click', (e) => {
    if (e.target === passModal) passModal.hidden = true;
  });

  passForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    passError.hidden = true;
    passSuccess.hidden = true;
    const currentPassword = (document.getElementById('current-password') as HTMLInputElement).value;
    const newPassword = (document.getElementById('new-password') as HTMLInputElement).value;
    const token = getToken();
    if (!token) return;
    try {
      const res = await fetch(`${getApiBase()}/api/auth/change-password`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Authorization: `Bearer ${token}`
        },
        body: JSON.stringify({ currentPassword, newPassword })
      });
      const data = await res.json();
      if (!res.ok) {
        passError.textContent = data.error || 'Error al cambiar contraseña';
        passError.hidden = false;
        return;
      }
      passSuccess.hidden = false;
      setTimeout(() => { passModal.hidden = true; }, 1500);
    } catch {
      passError.textContent = 'Error de conexión';
      passError.hidden = false;
    }
  });

  document.addEventListener('DOMContentLoaded', checkSession);
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(1, 2, 7, 0.95);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid #2a2a35;
    padding-top: env(safe-area-inset-top);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), background 0.3s;
  }

  .site-header.header-hidden {
    transform: translateY(-100%);
  }

  .header-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0.75rem 1rem;
    padding-left: max(0.75rem, env(safe-area-inset-left));
    padding-right: max(0.75rem, env(safe-area-inset-right));
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .header-profile {
    flex-shrink: 0;
    z-index: 10;
  }

  .profile-btn {
    background: transparent;
    border: none;
    padding: 0;
    cursor: pointer;
    border-radius: 50%;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .profile-btn:hover .avatar {
    box-shadow: 0 0 20px rgba(139, 92, 246, 0.5), 0 0 40px rgba(139, 92, 246, 0.3);
    transform: scale(1.05);
  }

  .avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: linear-gradient(135deg, #6366f1, #8b5cf6);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    border: 2px solid rgba(139, 92, 246, 0.3);
  }

  .avatar-init {
    color: #fff;
    font-weight: 700;
    font-size: 1rem;
  }

  /* Desktop dropdown */
  .profile-dropdown {
    position: absolute;
    top: 100%;
    right: 0;
    margin-top: 0.5rem;
    z-index: 200;
  }

  .profile-dropdown[hidden] {
    display: none;
  }

  .dropdown-backdrop {
    position: fixed;
    inset: 0;
  }

  .dropdown-content {
    background: rgba(17, 24, 39, 0.95);
    backdrop-filter: blur(16px) saturate(180%);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    border: 1px solid rgba(42, 42, 53, 0.8);
    border-radius: 16px;
    padding: 0.5rem;
    min-width: 200px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5), 0 0 20px rgba(139, 92, 246, 0.1);
    animation: dropdownFadeIn 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  @keyframes dropdownFadeIn {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .dropdown-header {
    padding: 0.75rem;
  }

  .user-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .user-name {
    color: #fefefe;
    font-weight: 600;
    font-size: 0.95rem;
  }

  .user-role {
    color: #8b5cf6;
    font-size: 0.75rem;
    text-transform: capitalize;
  }

  .dropdown-divider {
    height: 1px;
    background: rgba(42, 42, 53, 0.8);
    margin: 0.5rem 0;
  }

  .dropdown-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    padding: 0.75rem;
    background: transparent;
    border: none;
    border-radius: 12px;
    color: #d1d5db;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    text-align: left;
  }

  .dropdown-item:hover {
    background: rgba(139, 92, 246, 0.15);
    color: #fefefe;
  }

  .dropdown-item-danger:hover {
    background: rgba(239, 68, 68, 0.15);
    color: #ef4444;
  }

  /* Logo */
  .logo {
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    color: #fefefe;
    flex-shrink: 0;
    margin: 1rem;
  }

  .logo svg {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    margin: 1rem;
  }

  @media (min-width: 768px) {
    .logo svg {
      width: 52px;
      height: 52px;
      margin: 1rem;
    }
  }

  /* Navigation */
  .main-nav {
    flex: 1;
    display: flex;
    justify-content: flex-end;
  }

  .nav-list {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
    justify-content: center;
  }

  .nav-list a {
    display: block;
    padding: 0.5rem 0.75rem;
    color: #aaa;
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    border-radius: 8px;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  @media (min-width: 640px) {
    .nav-list a {
      padding: 0.5rem 1rem;
      font-size: 0.95rem;
    }
  }

  .nav-list a:hover,
  .nav-list a:focus {
    color: #fefefe;
    background: rgba(139, 92, 246, 0.15);
    box-shadow: 0 0 15px rgba(139, 92, 246, 0.2);
  }

  .nav-list a:focus-visible {
    outline: 2px solid #8b5cf6;
    outline-offset: 2px;
  }

  .auth-section {
    display: flex;
    align-items: center;
  }

  .btn-login {
    background: linear-gradient(135deg, #6366f1, #8b5cf6);
    color: #fff;
    border: none;
    padding: 0.5rem 1rem;
    border-radius: 12px;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    min-height: 36px;
    box-shadow: 0 4px 15px rgba(139, 92, 246, 0.3);
  }

  @media (min-width: 640px) {
    .btn-login {
      padding: 0.5rem 1.25rem;
      font-size: 0.9rem;
    }
  }

  .btn-login:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(139, 92, 246, 0.5);
  }

  /* Mobile Sheet */
  .mobile-sheet {
    position: fixed;
    inset: 0;
    z-index: 1000;
  }

  .mobile-sheet[hidden] {
    display: none;
  }

  .sheet-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
    animation: fadeIn 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .sheet-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: #111827;
    border-top: 1px solid rgba(42, 42, 53, 0.8);
    border-radius: 24px 24px 0 0;
    padding: 1.5rem;
