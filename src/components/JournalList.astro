<section class="journal-list">
  <div class="filter-bar">
    <label for="user-filter" class="filter-label">Filtrar:</label>
    <select id="user-filter" class="user-filter-select">
      <option value="all">Todos</option>
    </select>
    <span id="entry-count" class="entry-count"></span>
  </div>
  <div class="chart-section">
    <h3 class="chart-title">Patrones Energy × Valence</h3>
    <p class="chart-subtitle">Evolución de tus sesiones</p>
    <div id="journal-chart" class="journal-chart"></div>
    <div class="chart-legend">
      <span class="legend-item"><span class="dot pre"></span> Pre-práctica</span>
      <span class="legend-item"><span class="dot post"></span> Post-práctica</span>
    </div>
  </div>
  <div id="journal-entries" class="entries-list">
    <div class="loading-state">Cargando entradas...</div>
  </div>
</section>

<div id="detail-modal" class="modal-overlay hidden" role="dialog" aria-modal="true" aria-labelledby="detail-title">
  <div class="modal detail-modal">
    <button class="close-modal-btn" aria-label="Cerrar">Close</button>
    <h2 id="detail-title">Detalles de la Entrada</h2>
    <div id="detail-content" class="detail-content"></div>
  </div>
</div>

<div id="edit-modal" class="modal-overlay hidden" role="dialog" aria-modal="true" aria-labelledby="edit-modal-title">
  <div class="modal edit-modal">
    <button id="close-edit-modal" class="close-modal-btn" aria-label="Cerrar">Close</button>
    <h2 id="edit-modal-title">Editar Entrada</h2>
    <form id="edit-form">
      <input type="hidden" id="edit-id" name="id" />
      <fieldset>
        <legend>Metadatos</legend>
        <div class="grid">
          <label>
            Fecha
            <input type="date" id="edit-fecha" name="fecha" required />
          </label>
          <label>
            Hora
            <input type="time" id="edit-hora" name="hora" />
          </label>
          <label>
            Duración (min)
            <input type="number" id="edit-duracion" name="duracion" min="1" />
          </label>
        </div>
        <label>
          Tipo de Práctica
          <select id="edit-tipo" name="tipo_practica" required></select>
        </label>
      </fieldset>

      <fieldset>
        <legend>Fenomenología y Estado</legend>
        <label>
          Estado Previo
          <input type="text" id="edit-estado-previo" name="estado_previo" required />
        </label>

        <div class="edit-sliders">
          <div class="edit-slider-group">
            <label>ENERGY (Pre)</label>
            <input type="range" id="edit-energy-pre" name="energy_pre" min="-5" max="5" step="1" />
            <span class="edit-slider-value" id="edit-energy-pre-val">—</span>
          </div>
          <div class="edit-slider-group">
            <label>VALENCE (Pre)</label>
            <input type="range" id="edit-valence-pre" name="valence_pre" min="-5" max="5" step="1" />
            <span class="edit-slider-value" id="edit-valence-pre-val">—</span>
          </div>
        </div>

        <label>
          Fenomenología Somática (Sensaciones corporales)
          <input type="text" id="edit-fenomenologia-somatica" name="fenomenologia_somatica" required />
          <span class="helper">Describe lo que observas, no por qué sucede</span>
        </label>
        <label>
          Fenomenología Cognitiva (Pensamientos observados)
          <textarea id="edit-fenomenologia-cognitiva" name="fenomenologia_cognitiva" rows="3"></textarea>
          <span class="helper">Describe lo que observas, no por qué sucede</span>
        </label>
        <label>
          Descripción Detallada
          <textarea id="edit-cuerpo" name="cuerpo" rows="4"></textarea>
        </label>
      </fieldset>

      <fieldset>
        <legend>Análisis e Integración</legend>
        <label>
          Insight Principal
          <input type="text" id="edit-insight" name="insight" />
        </label>
        <label>
          Plan de Integración
          <input type="text" id="edit-integracion" name="integracion" />
        </label>
        <label>
          Estado Post-Práctica
          <input type="text" id="edit-estado-post" name="estado_post" required />
        </label>

        <div class="edit-sliders">
          <div class="edit-slider-group">
            <label>ENERGY (Post)</label>
            <input type="range" id="edit-energy-post" name="energy_post" min="-5" max="5" step="1" />
            <span class="edit-slider-value" id="edit-energy-post-val">—</span>
          </div>
          <div class="edit-slider-group">
            <label>VALENCE (Post)</label>
            <input type="range" id="edit-valence-post" name="valence_post" min="-5" max="5" step="1" />
            <span class="edit-slider-value" id="edit-valence-post-val">—</span>
          </div>
        </div>
      </fieldset>

      <div id="edit-msg" class="msg"></div>
      <button type="submit" class="submit-btn">Guardar Cambios</button>
    </form>
  </div>
</div>

<script>
  import { renderEntryDashboard } from "./EntryDashboard.jsx";
  import { render3DChart } from "./Chart3D.jsx";
  interface JournalEntry {
    id: number;
    fecha: string;
    hora: string | null;
    duracion: number | null;
    tipo_practica: string;
    estado_previo: string;
    fenomenologia_somatica: string;
    fenomenologia_cognitiva: string | null;
    cuerpo: string | null;
    insight: string | null;
    integracion: string | null;
    estado_post: string;
    energy_pre: number | null;
    valence_pre: number | null;
    energy_post: number | null;
    valence_post: number | null;
    created_at: string;
    user_id: number | null;
    username?: string | null;
  }

  let practiceLabels: Record<string, string> = {
    mindfulness: "Mindfulness",
    trataka: "Trataka",
    visualizacion: "Visualización Guiada",
    shambhavi: "Third Eye Gazing",
    escritura: "Escritura Reflectiva",
  };

  async function loadPracticeLabels() {
    try {
      const token = localStorage.getItem('psy_token');
      const res = await fetch(`${getApiBase()}/api/practices`, token ? { headers: { Authorization: `Bearer ${token}` } } : {});
      if (res.ok) {
        const practices: { slug: string; label: string }[] = await res.json();
        practiceLabels = {};
        for (const p of practices) practiceLabels[p.slug] = p.label;
      }
    } catch { }
    renderJournal();
    renderDetailDashboard();
  }

  function getPracticeLabel(key: string): string {
    return practiceLabels[key] || key;
  }

  function formatDate(dateStr: string): string {
    const d = new Date(dateStr + "T00:00:00");
    return d.toLocaleDateString("es-ES", {
      day: "2-digit",
      month: "short",
      year: "numeric",
    });
  }

  function formatTime(timeStr: string | null): string {
    if (!timeStr) return "";
    const [h, m] = timeStr.split(":");
    return h + ":" + m;
  }

  const detailModal = document.getElementById("detail-modal");
  const editModal = document.getElementById("edit-modal");
  const closeDetailBtn = detailModal?.querySelector(".close-modal-btn");
  const closeEditBtn = document.getElementById("close-edit-modal");
  const editForm = document.getElementById("edit-form") as HTMLFormElement;
  const editMsg = document.getElementById("edit-msg");

  function openDetailModal(entry: JournalEntry) {
    const content = document.getElementById("detail-content");
    if (!content) return;

    content.innerHTML = `
      <div class="detail-grid">
        <div class="detail-meta">
          <span class="detail-date">${formatDate(entry.fecha)}</span>
          <span class="detail-time">${formatTime(entry.hora)}</span>
          <span class="detail-duration">${entry.duracion ? entry.duracion + " min" : ""}</span>
        </div>
        
        <div class="detail-section">
          <h3>Técnica</h3>
          <p>${getPracticeLabel(entry.tipo_practica)}</p>
        </div>

        <div class="detail-section">
          <h3>Estado Previo</h3>
          <p>${entry.estado_previo}</p>
        </div>

        <div class="detail-section">
          <h3>Fenomenología Somática</h3>
          <p>${entry.fenomenologia_somatica}</p>
        </div>

        ${entry.fenomenologia_cognitiva ? `
          <div class="detail-section">
            <h3>Fenomenología Cognitiva</h3>
            <p>${entry.fenomenologia_cognitiva}</p>
          </div>
        ` : ''}

        ${entry.cuerpo ? `
          <div class="detail-section">
            <h3>Descripción Corporal</h3>
            <p class="text-block">${entry.cuerpo}</p>
          </div>
        ` : ""}

        ${entry.insight ? `
          <div class="detail-section">
            <h3>Insight Principal</h3>
            <p>${entry.insight}</p>
          </div>
        ` : ""}

        ${entry.integracion ? `
          <div class="detail-section">
            <h3>Plan de Integración</h3>
            <p>${entry.integracion}</p>
          </div>
        ` : ""}

        <div class="detail-section">
          <h3>Estado Post-Práctica</h3>
          <p>${entry.estado_post}</p>
        </div>

        ${(entry.energy_pre != null || entry.valence_pre != null || entry.energy_post != null || entry.valence_post != null) ? `
          <div class="detail-section">
            <h3>Medición Continua</h3>
            <div id="entry-dashboard-container" class="entry-dashboard-container"></div>
          </div>
        ` : ''}
      </div>
    `;

    detailModal?.classList.remove("hidden");

    const dashContainer = document.getElementById("entry-dashboard-container");
    if (dashContainer && (entry.energy_pre != null || entry.valence_pre != null || entry.energy_post != null || entry.valence_post != null)) {
      dashContainer.innerHTML = renderEntryDashboard(
        entry.energy_pre,
        entry.valence_pre,
        entry.energy_post,
        entry.valence_post,
        entry.fecha
      );
    }
  }

  function formatContinuous(value: number): string {
    return value > 0 ? `+${value}` : String(value);
  }

  function closeDetailModal() {
    detailModal?.classList.add("hidden");
  }

  function openEditModal(entry: JournalEntry) {
    (document.getElementById("edit-id") as HTMLInputElement).value = String(entry.id);
    (document.getElementById("edit-fecha") as HTMLInputElement).value = entry.fecha;
    (document.getElementById("edit-hora") as HTMLInputElement).value = entry.hora || "";
    (document.getElementById("edit-duracion") as HTMLInputElement).value = String(entry.duracion || "");
    const editTipo = document.getElementById("edit-tipo") as HTMLSelectElement;
    editTipo.innerHTML = Object.entries(practiceLabels).map(([k, v]) => `<option value="${k}">${v}</option>`).join("");
    editTipo.value = entry.tipo_practica;
    (document.getElementById("edit-estado-previo") as HTMLInputElement).value = entry.estado_previo;
    (document.getElementById("edit-fenomenologia-somatica") as HTMLInputElement).value = entry.fenomenologia_somatica;
    (document.getElementById("edit-fenomenologia-cognitiva") as HTMLTextAreaElement).value = entry.fenomenologia_cognitiva || "";
    (document.getElementById("edit-cuerpo") as HTMLTextAreaElement).value = entry.cuerpo || "";
    (document.getElementById("edit-insight") as HTMLInputElement).value = entry.insight || "";
    (document.getElementById("edit-integracion") as HTMLInputElement).value = entry.integracion || "";
    (document.getElementById("edit-estado-post") as HTMLInputElement).value = entry.estado_post;

    // Energy/Valence sliders
    setSliderValue("edit-energy-pre", "edit-energy-pre-val", entry.energy_pre);
    setSliderValue("edit-valence-pre", "edit-valence-pre-val", entry.valence_pre);
    setSliderValue("edit-energy-post", "edit-energy-post-val", entry.energy_post);
    setSliderValue("edit-valence-post", "edit-valence-post-val", entry.valence_post);

    if (editMsg) editMsg.textContent = "";
    editModal?.classList.remove("hidden");
  }

  function setSliderValue(sliderId: string, valueId: string, value: number | null) {
    const slider = document.getElementById(sliderId) as HTMLInputElement;
    const valueDisplay = document.getElementById(valueId);
    if (slider && valueDisplay) {
      slider.value = value !== null ? String(value) : "0";
      valueDisplay.textContent = value !== null ? (value === 0 ? "—" : (value > 0 ? `+${value}` : String(value))) : "—";
    }
  }

  // Slider display update
  document.querySelectorAll("#edit-form input[type='range']").forEach((slider) => {
    slider.addEventListener("input", (e) => {
      const target = e.target as HTMLInputElement;
      const valueId = target.id.replace("edit-", "edit-") + "-val";
      const valueDisplay = document.getElementById(target.id + "-val");
      if (valueDisplay) {
        const val = parseInt(target.value);
        valueDisplay.textContent = val === 0 ? "—" : (val > 0 ? `+${val}` : String(val));
      }
    });
  });

  function closeEditModal() {
    editModal?.classList.add("hidden");
    if (editMsg) editMsg.textContent = "";
    editForm?.reset();
  }

  closeDetailBtn?.addEventListener("click", closeDetailModal);
  closeEditBtn?.addEventListener("click", closeEditModal);

  detailModal?.addEventListener("click", function(e) {
    if (e.target === detailModal) closeDetailModal();
  });

  editModal?.addEventListener("click", function(e) {
    if (e.target === editModal) closeEditModal();
  });

  document.addEventListener("keydown", function(e) {
    if (e.key === "Escape") {
      closeDetailModal();
      closeEditModal();
    }
  });

  editForm?.addEventListener("submit", async function(e) {
    e.preventDefault();
    if (!editMsg) return;
    editMsg.textContent = "";

    var formData = new FormData(editForm);
    var id = formData.get("id");
    var sliderFields = ["energy_pre", "valence_pre", "energy_post", "valence_post"];
    var payload: Record<string, any> = {
      fecha: formData.get("fecha"),
      hora: formData.get("hora"),
      duracion: formData.get("duracion"),
      tipo_practica: formData.get("tipo_practica"),
      estado_previo: formData.get("estado_previo"),
      fenomenologia_somatica: formData.get("fenomenologia_somatica"),
      fenomenologia_cognitiva: formData.get("fenomenologia_cognitiva"),
      cuerpo: formData.get("cuerpo"),
      insight: formData.get("insight"),
      integracion: formData.get("integracion"),
      estado_post: formData.get("estado_post"),
    };
    
    // Handle slider values - convert default 0 to null if not changed
    sliderFields.forEach(function(field) {
      var val = formData.get(field);
      if (val === "0" || val === "") {
        payload[field] = null;
      } else {
        payload[field] = parseInt(val as string);
      }
    });

    try {
      var res = await fetch("/api/journal/" + id, {
        method: "PUT",
        headers: { "Content-Type": "application/json", ...getAuthHeaders() },
        body: JSON.stringify(payload),
      });
      var data = await res.json();
      if (data.ok) {
        editMsg.className = "msg success";
        editMsg.textContent = "Entrada actualizada correctamente";
        setTimeout(function() {
          closeEditModal();
          loadEntries();
        }, 800);
      } else {
        editMsg.className = "msg error";
        editMsg.textContent = data.error || "Error al guardar";
      }
    } catch {
      editMsg.className = "msg error";
      editMsg.textContent = "Error de conexión";
    }
  });

  function getAuthHeaders(): Record<string, string> {
      const token = localStorage.getItem("psy_token");
      return token ? { Authorization: `Bearer ${token}` } : {};
    }

    function getCurrentUser(): { id: number; role: string } | null {
      const u = localStorage.getItem("psy_user");
      return u ? JSON.parse(u) : null;
    }

    function canEdit(entry: { user_id: number | null }): boolean {
      const user = getCurrentUser();
      if (!user) return false;
      if (user.role === "admin") return true;
      return entry.user_id === user.id;
    }

    async function deleteEntry(id) {
      if (!confirm("Eliminar esta entrada?")) return;
      try {
        var res = await fetch("/api/journal/" + id, { method: "DELETE", headers: getAuthHeaders() });
        if (res.ok) loadEntries();
      } catch (err) {
        console.error("Error deleting:", err);
      }
    }

  async function loadEntries() {
    var container = document.getElementById("journal-entries");
    if (!container) return;

    try {
      var res = await fetch("/api/journal", { headers: getAuthHeaders() });
      var text = await res.text();
      var entries;
      try {
        entries = JSON.parse(text);
      } catch (e) {
        container.innerHTML = '<div class="error-state">Error parseando respuesta: ' + res.status + '</div>';
        console.error("JSON parse error:", text);
        return;
      }

      if (entries.length === 0) {
        container.innerHTML = '<div class="empty-state"><p>No hay entradas en tu bitácora aún.</p><a href="/practica" class="empty-link">Crear primera entrada →</a></div>';
        return;
      }

      var showUserCol = entries.some(function(e) { return e.username; });
      var grouped = {};
      if (showUserCol) {
        entries.forEach(function(e) {
          var key = e.username || "—";
          if (!grouped[key]) grouped[key] = [];
          grouped[key].push(e);
        });
        Object.keys(grouped).forEach(function(key) {
          grouped[key].sort(function(a, b) {
            return (b.fecha + (b.hora || "")).localeCompare(a.fecha + (a.hora || ""));
          });
        });
      } else {
        grouped = { "": entries.slice().sort(function(a, b) {
          return (b.fecha + (b.hora || "")).localeCompare(a.fecha + (a.hora || ""));
        })};
      }

      window._journalData = entries;
      window._journalGrouped = grouped;
      window._journalShowUserCol = showUserCol;

      var filterSelect = document.getElementById("user-filter");
      var countSpan = document.getElementById("entry-count");
      if (filterSelect) {
        filterSelect.innerHTML = '<option value="all">Todos los usuarios</option>';
        Object.keys(grouped).sort().forEach(function(user) {
          var opt = document.createElement("option");
          opt.value = user;
          opt.textContent = (user || "Sin usuario") + " (" + grouped[user].length + ")";
          filterSelect.appendChild(opt);
        });
      }

      function renderEntries(filterUser) {
        var keys = filterUser === "all"
          ? Object.keys(grouped).sort()
          : [filterUser];

        var total = 0;
        container.innerHTML = keys.map(function(user) {
          var userEntries = grouped[user];
          total += userEntries.length;
          var headerHtml = user ? '<div class="group-header"><span class="group-user">' + (user || "Sin usuario") + '</span><span class="group-count">' + userEntries.length + ' entrada' + (userEntries.length !== 1 ? "s" : "") + '</span></div>' : '';
          return headerHtml +
            '<div class="entries-container">' + userEntries.map(function(e) {
              var canEditEntry = canEdit(e);
              var dateTimeHtml = formatDate(e.fecha) + (e.hora ? ' · ' + formatTime(e.hora) : '');
              return '<div class="entry-card" data-id="' + e.id + '">' +
                '<div class="entry-card-header">' +
                '<span class="entry-card-tecnica">' + getPracticeLabel(e.tipo_practica) + '</span>' +
                '<span class="entry-card-datetime">' + dateTimeHtml + '</span>' +
                '</div>' +
                '<div class="entry-card-body">' +
                '<span class="entry-card-label">Insight:</span>' +
                '<span class="entry-card-insight">' + (e.insight || "Sin insight registrado") + '</span>' +
                '</div>' +
                '<div class="entry-card-footer">' +
                '<button class="action-btn view-btn" data-id="' + e.id + '" aria-label="Ver detalles">Ver</button>' +
                (canEditEntry ? '<button class="action-btn edit-btn" data-id="' + e.id + '" aria-label="Editar">Editar</button><button class="action-btn delete-btn" data-id="' + e.id + '" aria-label="Eliminar">Eliminar</button>' : '') +
                '</div></div>';
            }).join("") + '</div>';
        }).join("");

        if (countSpan) {
          countSpan.textContent = total + " entrada" + (total !== 1 ? "s" : "");
        }

        container.querySelectorAll(".view-btn").forEach(function(btn) {
          btn.addEventListener("click", function(e) {
            var target = e.target as HTMLElement;
            var btn2 = target.closest("[data-id]") as HTMLElement;
            var id = Number(btn2.getAttribute("data-id"));
            var entry = entries.find(function(ent) { return ent.id === id; });
            if (entry) openDetailModal(entry);
          });
        });

        container.querySelectorAll(".edit-btn").forEach(function(btn) {
          btn.addEventListener("click", function(e) {
            var target = e.target as HTMLElement;
            var btn2 = target.closest("[data-id]") as HTMLElement;
            var id = Number(btn2.getAttribute("data-id"));
            var entry = entries.find(function(ent) { return ent.id === id; });
            if (entry) openEditModal(entry);
          });
        });

        container.querySelectorAll(".delete-btn").forEach(function(btn) {
          btn.addEventListener("click", function(e) {
            var target = e.target as HTMLElement;
            var btn2 = target.closest("[data-id]") as HTMLElement;
            var id = Number(btn2.getAttribute("data-id"));
            deleteEntry(id);
          });
        });
      }

      function renderChartData(filterUser) {
        var keys = filterUser === "all"
          ? Object.keys(grouped).sort()
          : [filterUser];
        var chartEntries: Array<JournalEntry> = [];
        keys.forEach(function(user) {
          chartEntries = chartEntries.concat(grouped[user]);
        });
        var chartContainer = document.getElementById("journal-chart");
        if (chartContainer) {
          chartContainer.innerHTML = render3DChart(chartEntries);
          var tip = chartContainer.querySelector(".chart-tt");
          chartContainer.querySelectorAll(".pt").forEach(function(el) {
            el.addEventListener("mouseover", function(e) {
              if (tip) {
                tip.textContent = el.getAttribute("data-tip") || "";
                tip.style.display = "block";
              }
            });
            el.addEventListener("mousemove", function(e) {
              if (tip) {
                tip.style.left = (e.clientX + 12) + "px";
                tip.style.top = (e.clientY - 28) + "px";
              }
            });
            el.addEventListener("mouseout", function() {
              if (tip) tip.style.display = "none";
            });
          });
        }
      }

      if (filterSelect) {
        filterSelect.addEventListener("change", function() {
          renderEntries(filterSelect.value);
          renderChartData(filterSelect.value);
        });
      }

      renderEntries("all");
      renderChartData("all");

      var urlParams = new URLSearchParams(window.location.search);
      var highlightId = urlParams.get("highlight");
      if (highlightId) {
        var highlightNum = parseInt(highlightId, 10);
        setTimeout(function() {
          var entryRow = document.querySelector('[data-id="' + highlightId + '"]');
          if (entryRow) {
            entryRow.scrollIntoView({ behavior: "smooth", block: "center" });
            entryRow.classList.add("highlighted-entry");
          }
          var entry = entries.find(function(e) { return e.id === highlightNum; });
          if (entry) {
            openDetailModal(entry);
          }
        }, 300);
      }
    } catch (err) {
      container.innerHTML = '<tr class="error-row"><td colspan="5">Error al cargar las entradas: ' + (err.message || String(err)) + '</td></tr>';
      console.error("loadEntries error:", err);
    }
  }

  loadEntries();

  window.addEventListener("journal-updated", () => {
    loadEntries();
  });
</script>

<style>
  .journal-list {
    width: 100%;
    max-width: 100%;
    overflow-x: hidden;
  }

  .filter-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }

  .filter-label {
    font-size: 0.8rem;
    color: #6b7280;
  }

  @media (min-width: 640px) {
    .filter-label {
      font-size: 0.85rem;
    }
  }

  .user-filter-select {
    background: #1f1f35;
    color: #e5e7eb;
    border: 1px solid #2a2a35;
    border-radius: 8px;
    padding: 0.4rem 0.5rem;
    font-size: 0.8rem;
    cursor: pointer;
    min-height: 36px;
  }

  @media (min-width: 640px) {
