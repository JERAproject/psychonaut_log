---
---

<section class="journal-list">
  <h2 class="section-title">Entradas Guardadas</h2>

  <div id="journal-entries" class="entries">
    <div class="loading">Cargando...</div>
  </div>
</section>

<div id="edit-modal" class="modal-overlay hidden" role="dialog" aria-modal="true" aria-labelledby="modal-title">
  <div class="modal">
    <button id="close-modal" class="close-btn" aria-label="Cerrar modal">&times;</button>
    <h2 id="modal-title">Editar Entrada</h2>
    <form id="edit-form">
      <input type="hidden" id="edit-id" name="id" />
      <fieldset>
        <legend>Metadatos</legend>
        <div class="grid">
          <label>
            Fecha
            <input type="date" id="edit-fecha" name="fecha" required />
          </label>
          <label>
            Hora
            <input type="time" id="edit-hora" name="hora" />
          </label>
          <label>
            Duración (min)
            <input type="number" id="edit-duracion" name="duracion" min="1" />
          </label>
        </div>
        <label>
          Tipo de Práctica
          <select id="edit-tipo" name="tipo_practica" required>
            <option value="mindfulness">Mindfulness</option>
            <option value="trataka">Trataka</option>
            <option value="visualizacion">Visualización Guiada</option>
            <option value="shambhavi">Third Eye Gazing (Shambhavi)</option>
            <option value="escritura">Escritura Reflectiva</option>
          </select>
        </label>
      </fieldset>

      <fieldset>
        <legend>Fenomenología y Estado</legend>
        <label>
          Estado Previo
          <input type="text" id="edit-estado-previo" name="estado_previo" required />
        </label>
        <label>
          Fenomenología
          <input type="text" id="edit-fenomenologia" name="fenomenologia" required />
        </label>
        <label>
          Descripción Detallada
          <textarea id="edit-cuerpo" name="cuerpo" rows="4"></textarea>
        </label>
      </fieldset>

      <fieldset>
        <legend>Análisis e Integración</legend>
        <label>
          Insight Principal
          <input type="text" id="edit-insight" name="insight" />
        </label>
        <label>
          Plan de Integración
          <input type="text" id="edit-integracion" name="integracion" />
        </label>
        <label>
          Estado Post-Práctica
          <input type="text" id="edit-estado-post" name="estado_post" required />
        </label>
      </fieldset>

      <div id="edit-msg" class="msg"></div>
      <button type="submit" class="submit-btn">Guardar Cambios</button>
    </form>
  </div>
</div>

<script>
  interface JournalEntry {
    id: number;
    fecha: string;
    hora: string | null;
    duracion: number | null;
    tipo_practica: string;
    estado_previo: string;
    fenomenologia: string;
    cuerpo: string | null;
    insight: string | null;
    integracion: string | null;
    estado_post: string;
    created_at: string;
  }

  const practiceLabels: Record<string, string> = {
    mindfulness: "Mindfulness",
    trataka: "Trataka",
    visualizacion: "Visualización Guiada",
    shambhavi: "Third Eye Gazing (Shambhavi)",
    escritura: "Escritura Reflectiva",
  };

  function formatDate(dateStr: string): string {
    const d = new Date(dateStr + "T00:00:00");
    return d.toLocaleDateString("es-ES", {
      weekday: "short",
      day: "numeric",
      month: "short",
      year: "numeric",
    });
  }

  const modal = document.getElementById("edit-modal");
  const closeBtn = document.getElementById("close-modal");
  const form = document.getElementById("edit-form") as HTMLFormElement;
  const msg = document.getElementById("edit-msg");

  function openModal(entry: JournalEntry) {
    (document.getElementById("edit-id") as HTMLInputElement).value = String(entry.id);
    (document.getElementById("edit-fecha") as HTMLInputElement).value = entry.fecha;
    (document.getElementById("edit-hora") as HTMLInputElement).value = entry.hora || "";
    (document.getElementById("edit-duracion") as HTMLInputElement).value = String(entry.duracion || "");
    (document.getElementById("edit-tipo") as HTMLSelectElement).value = entry.tipo_practica;
    (document.getElementById("edit-estado-previo") as HTMLInputElement).value = entry.estado_previo;
    (document.getElementById("edit-fenomenologia") as HTMLInputElement).value = entry.fenomenologia;
    (document.getElementById("edit-cuerpo") as HTMLTextAreaElement).value = entry.cuerpo || "";
    (document.getElementById("edit-insight") as HTMLInputElement).value = entry.insight || "";
    (document.getElementById("edit-integracion") as HTMLInputElement).value = entry.integracion || "";
    (document.getElementById("edit-estado-post") as HTMLInputElement).value = entry.estado_post;
    
    if (msg) msg.textContent = "";
    modal?.classList.remove("hidden");
  }

  function closeModal() {
    modal?.classList.add("hidden");
    if (msg) msg.textContent = "";
    form?.reset();
  }

  closeBtn?.addEventListener("click", closeModal);
  modal?.addEventListener("click", (e) => {
    if (e.target === modal) closeModal();
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeModal();
  });

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!msg) return;
    msg.textContent = "";

    const formData = new FormData(form);
    const id = formData.get("id");
    const payload = {
      fecha: formData.get("fecha"),
      hora: formData.get("hora"),
      duracion: formData.get("duracion"),
      tipo_practica: formData.get("tipo_practica"),
      estado_previo: formData.get("estado_previo"),
      fenomenologia: formData.get("fenomenologia"),
      cuerpo: formData.get("cuerpo"),
      insight: formData.get("insight"),
      integracion: formData.get("integracion"),
      estado_post: formData.get("estado_post"),
    };

    try {
      const res = await fetch(`/api/journal/${id}`, {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      const data = await res.json();
      if (data.ok) {
        msg.className = "msg success";
        msg.textContent = "Entrada actualizada correctamente";
        setTimeout(() => {
          closeModal();
          loadEntries();
        }, 800);
      } else {
        msg.className = "msg error";
        msg.textContent = data.error || "Error al guardar";
      }
    } catch {
      msg.className = "msg error";
      msg.textContent = "Error de conexión";
    }
  });

  async function deleteEntry(id: number) {
    if (!confirm("¿Eliminar esta entrada?")) return;
    try {
      const res = await fetch(`/api/journal/${id}`, { method: "DELETE" });
      if (res.ok) loadEntries();
    } catch (err) {
      console.error("Error deleting:", err);
    }
  }

  async function loadEntries() {
    const container = document.getElementById("journal-entries");
    if (!container) return;

    try {
      const res = await fetch("/api/journal");
      const entries: JournalEntry[] = await res.json();

      if (entries.length === 0) {
        container.innerHTML = `
          <div class="empty-state">
            <p>No hay entradas en tu bitácora aún.</p>
            <a href="/enterData" class="empty-link">Crear primera entrada →</a>
          </div>
        `;
        return;
      }

      container.innerHTML = entries
        .map(
          (e) => `
        <details class="entry-card">
          <summary class="entry-header">
            <div class="entry-meta">
              <span class="entry-date">${formatDate(e.fecha)}</span>
              <span class="entry-type">${practiceLabels[e.tipo_practica] || e.tipo_practica}</span>
              ${e.duracion ? `<span class="entry-duration">${e.duracion} min</span>` : ""}
            </div>
            <div class="entry-insight">${e.insight || "Sin insight registrado"}</div>
          </summary>
          <div class="entry-body">
            <div class="entry-row">
              <span class="entry-label">Estado previo</span>
              <p>${e.estado_previo}</p>
            </div>
            <div class="entry-row">
              <span class="entry-label">Fenomenología</span>
              <p>${e.fenomenologia}</p>
            </div>
            ${e.cuerpo ? `<div class="entry-row"><span class="entry-label">Descripción</span><p class="entry-text">${e.cuerpo}</p></div>` : ""}
            ${e.integracion ? `<div class="entry-row"><span class="entry-label">Plan de integración</span><p>${e.integracion}</p></div>` : ""}
            <div class="entry-row">
              <span class="entry-label">Estado post-práctica</span>
              <p>${e.estado_post}</p>
            </div>
            <div class="entry-actions">
              <button class="action-btn edit-btn" data-id="${e.id}" aria-label="Editar entrada">Editar</button>
              <button class="action-btn delete-btn" data-id="${e.id}" aria-label="Eliminar entrada">Eliminar</button>
            </div>
          </div>
        </details>
      `
        )
        .join("");

      container.querySelectorAll(".edit-btn").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          const id = Number((e.target as HTMLElement).dataset.id);
          const entry = entries.find((ent) => ent.id === id);
          if (entry) openModal(entry);
        });
      });

      container.querySelectorAll(".delete-btn").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          const id = Number((e.target as HTMLElement).dataset.id);
          deleteEntry(id);
        });
      });
    } catch (err) {
      container.innerHTML = `<p class="error-msg">Error al cargar las entradas.</p>`;
      console.error(err);
    }
  }

  loadEntries();
</script>

<style>
  .journal-list {
    max-width: 720px;
    margin: 0 auto;
    padding: 1.5rem 1rem;
  }

  .section-title {
    font-size: 1.2rem;
    color: #fefefe;
    margin: 0 0 1.5rem;
  }

  .entries {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .loading {
    text-align: center;
    color: #666;
    padding: 2rem;
  }

  .error-msg {
    text-align: center;
    color: #e03131;
    padding: 2rem;
  }

  .empty-state {
    text-align: center;
    padding: 3rem 1rem;
    background: #111827;
    border-radius: 16px;
    border: 1px dashed #333;
  }

  .empty-state p {
    color: #666;
    margin: 0 0 1rem;
  }

  .empty-link {
    color: #5b8ff9;
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s;
  }

  .empty-link:hover {
    color: #4a7de0;
  }

  .entry-card {
    background: #111827;
    border: 1px solid #2a2a35;
    border-radius: 14px;
    overflow: hidden;
    transition: border-color 0.2s;
  }

  .entry-card:hover {
    border-color: #3a3a45;
  }

  .entry-card[open] {
    border-color: #5b8ff944;
  }

  .entry-header {
    cursor: pointer;
    padding: 1rem 1.25rem;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    position: relative;
    padding-left: 1.75rem;
  }

  .entry-header::-webkit-details-marker {
    display: none;
  }

  .entry-header::before {
    content: "▸";
    position: absolute;
    left: 0.5rem;
    color: #555;
    transition: transform 0.2s;
  }

  .entry-card[open] .entry-header::before {
    content: "▾";
  }

  .entry-meta {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 0.4rem;
  }

  .entry-date {
    font-size: 0.8rem;
    color: #888;
  }

  .entry-type {
    font-size: 0.7rem;
    padding: 0.15rem 0.5rem;
    background: #5b8ff922;
    color: #5b8ff9;
    border-radius: 6px;
    text-transform: capitalize;
  }

  .entry-duration {
    font-size: 0.75rem;
    color: #666;
  }

  .entry-insight {
    font-size: 0.9rem;
    color: #ccc;
    line-height: 1.4;
  }

  .entry-body {
    padding: 0 1.25rem 1.25rem;
    padding-left: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    border-top: 1px solid #1a1a2e;
    margin: 0 0.75rem;
    padding-top: 1rem;
  }

  .entry-row p {
    margin: 0.3rem 0 0;
    color: #bbb;
    line-height: 1.6;
    font-size: 0.9rem;
  }

  .entry-text {
    white-space: pre-wrap;
  }

  .entry-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #666;
    font-weight: 600;
  }

  .entry-actions {
    display: flex;
    gap: 0.75rem;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid #2a2a35;
  }

  .action-btn {
    padding: 0.5rem 1rem;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
  }

  .edit-btn {
    background: #2563eb;
    color: white;
    border: none;
  }

  .edit-btn:hover {
    background: #1d4ed8;
  }

  .delete-btn {
    background: transparent;
    color: #e03131;
    border: 1px solid #e03131;
  }

  .delete-btn:hover {
    background: #e03131;
    color: white;
  }

  .modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: flex-start;
    justify-content: center;
    z-index: 200;
    overflow-y: auto;
    padding: 2rem 1rem;
  }

  .modal-overlay.hidden {
    display: none;
  }

  .modal {
    background: #1a1a2e;
    border: 1px solid #333;
    border-radius: 16px;
    padding: 1.5rem;
    width: 100%;
    max-width: 600px;
    position: relative;
    color: #fefefe;
  }

  .modal h2 {
    margin: 0 0 1.5rem;
    font-size: 1.3rem;
  }

  .close-btn {
    position: absolute;
    top: 0.75rem;
    right: 1rem;
    background: none;
    border: none;
    color: #888;
    font-size: 1.5rem;
    cursor: pointer;
    line-height: 1;
  }

  .close-btn:hover {
    color: #fff;
  }

  .modal fieldset {
    border: 1px solid #2a2a35;
    border-radius: 12px;
    padding: 1rem;
    margin-bottom: 1rem;
    background: #111827;
  }

  .modal legend {
    font-weight: 600;
    padding: 0 0.5rem;
    color: #fafafa;
  }

  .modal .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 0.75rem;
  }

  .modal label {
    display: block;
    margin-bottom: 0.75rem;
    font-size: 0.85rem;
    color: #aaa;
  }

  .modal input,
  .modal select,
  .modal textarea {
    width: 100%;
    padding: 0.5rem 0.75rem;
    margin-top: 0.25rem;
    border: 1px solid #333;
    border-radius: 8px;
    background: #0d0d1a;
    color: #fefefe;
    font-size: 0.9rem;
    box-sizing: border-box;
  }

  .modal input:focus,
  .modal select:focus,
  .modal textarea:focus {
    outline: none;
    border-color: #5b8ff9;
  }

  .modal textarea {
    resize: vertical;
    min-height: 4rem;
  }

  .modal .msg {
    font-size: 0.85rem;
    margin-bottom: 0.75rem;
    min-height: 1.2em;
  }

  .modal .msg.success {
    color: #51cf66;
  }

  .modal .msg.error {
    color: #e03131;
  }

  .modal .submit-btn {
    width: 100%;
    padding: 0.75rem;
    background: #5b8ff9;
    color: #fff;
    border: none;
    border-radius: 10px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
  }

  .modal .submit-btn:hover {
    background: #4a7de0;
  }

  @media (max-width: 640px) {
    .modal {
      padding: 1rem;
    }

    .modal fieldset {
      padding: 0.75rem;
    }

    .entry-actions {
      flex-direction: column;
    }

    .action-btn {
      width: 100%;
      text-align: center;
    }
  }
</style>