import * as d3 from 'd3';

  // 1. Definición de tipos para TypeScript
  interface CustomNode extends d3.SimulationNodeDatum {
    id: string;
    r: number;
    color: string;
    opacity: number;
  }

  interface CustomLink extends d3.SimulationLinkDatum<CustomNode> {
    source: string | CustomNode;
    target: string | CustomNode;
  }

  const initGraph = () => {
    const svgElement = d3.select<SVGSVGElement, unknown>("#network-graph");
    if (!svgElement.node()) return;

    const { width, height } = svgElement.node()!.getBoundingClientRect();
    svgElement.attr("viewBox", [0, 0, width, height]);
    svgElement.selectAll("*").remove();

    // --- 2. Generación de Datos Complejos (Topología de "Islas") ---
    const nodes: CustomNode[] = [];
    const links: CustomLink[] = [];
    let nodeCount = 0;
    const genId = (p: string) => `${p}_${nodeCount++}`;

    // A. Núcleo Central (El "Continente")
    const hub = { id: genId('hub'), r: 25, color: '#000', opacity: 1 };
    nodes.push(hub);

    // Nodos internos del núcleo (grandes)
    const inner = Array.from({ length: 15 }, () => {
      const n = { id: genId('inner'), r: 12, color: '#333', opacity: 0.8 };
      nodes.push(n);
      links.push({ source: hub.id, target: n.id });
      return n;
    });

    // Nodos externos del núcleo (pequeños)
    Array.from({ length: 60 }, () => {
      const n = { id: genId('outer'), r: 6, color: '#666', opacity: 0.6 };
      nodes.push(n);
      links.push({ source: inner[Math.floor(Math.random() * inner.length)].id, target: n.id });
    });

    // B. Islas Periféricas (Clústeres desconectados)
    const islandCount = 8;
    for (let i = 0; i < islandCount; i++) {
      const islandSize = 4 + Math.floor(Math.random() * 13);
      const islandNodes = Array.from({ length: islandSize }, () => {
        const n = { id: genId('island'), r: 4, color: '#aaa', opacity: 0.4 };
        nodes.push(n);
        return n;
      });

      // Conectar nodos dentro de la isla (geometría simple)
      islandNodes.forEach((n, idx) => {
        if (idx < islandNodes.length - 1) {
          links.push({ source: n.id, target: islandNodes[idx + 1].id });
        }
      });
    }

    // --- 3. Simulación de Fuerza ---
    const simulation = d3.forceSimulation<CustomNode>(nodes)
      .force("charge", d3.forceManyBody().strength(-180))
      .force("link", d3.forceLink<CustomNode, CustomLink>(links).id(d => d.id).distance(25))
      .force("collide", d3.forceCollide().radius(d => (d as CustomNode).r + 2))
      .force("center", d3.forceCenter(width / 2, height / 2));

    // --- 4. Renderizado ---
    const linkG = svgElement.append("g").attr("class", "links");
    const nodeG = svgElement.append("g").attr("class", "nodes");

    const link = linkG.selectAll("line")
      .data(links)
      .join("line")
      .attr("stroke", "#ddd")
      .attr("stroke-opacity", 0.6)
      .attr("stroke-width", 0.4);

    const node = nodeG.selectAll<SVGGElement, CustomNode>("g")
      .data(nodes)
      .join("g")
      .call(d3.drag<any, any>()
        .on("start", (e, d) => {
          if (!e.active) simulation.alphaTarget(0.3).restart();
          d.fx = d.x; d.fy = d.y;
        })
        .on("drag", (e, d) => { d.fx = e.x; d.fy = e.y; })
        .on("end", (e, d) => {
          if (!e.active) simulation.alphaTarget(0);
          d.fx = null; d.fy = null;
        })
      );

    node.append("circle")
      .attr("r", d => d.r)
      .attr("fill", d => d.color)
      .attr("fill-opacity", d => d.opacity);

    simulation.on("tick", () => {
      link.attr("x1", (d: any) => d.source.x)
          .attr("y1", (d: any) => d.source.y)
          .attr("x2", (d: any) => d.target.x)
          .attr("y2", (d: any) => d.target.y);
      node.attr("transform", d => `translate(${d.x},${d.y})`);
    });
  };

  // Inicialización
  initGraph();
  window.addEventListener('resize', initGraph);
</script>

<style>
  .graph-container {
    width: 100%;
    height: 80vh;
    background: #010207;
    overflow: hidden;
    position: relative;
  }
  svg {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>