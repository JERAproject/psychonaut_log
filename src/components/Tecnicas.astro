---
import mindfulnessImg from '../assets/Mindfulness.png?url';
import tratakaImg from '../assets/Trataka.png?url';
import autohimnosisImg from '../assets/Autohimnosis.png?url';
import shambhaviImg from '../assets/Shambavi mudra.png?url';
import escrituraImg from '../assets/Escritura reflexiva.png?url';
import trackerImg from '../assets/Tracker.png?url';
---

<div>
    <div class="container">
        <a href="/enterData">
            <div class="card">
                <img src={mindfulnessImg} alt="Mindfulness" />
                <div class="card-text">
                    <h3>Mindfulness</h3>
                    <p>Práctica de atención plena en el presente.</p>
                </div>
            </div>
        </a>
        <a href="/enterData">
            <div class="card">
                <img src={tratakaImg} alt="Trataka" />
                <div class="card-text">
                    <h3>Trataka</h3>
                    <p>Visualización fija en un punto.</p>
                </div>
            </div>
        </a>
        <a href="/enterData">
            <div class="card">
                <img src={autohimnosisImg} alt="Visualización Guiada" />
                <div class="card-text">
                    <h3>Visualización Guiada</h3>
                    <p>Imagenes mentales detalladas y específicas.</p>
                </div>
            </div>
        </a>
        <a href="/enterData">
            <div class="card">
                <img src={shambhaviImg} alt="Shambhavi" />
                <div class="card-text">
                    <h3>Third Eye Gazing (Shambhavi)</h3>
                    <p>Observación del punto entre el entrecejo.</p>
                </div>
            </div>
        </a>
        <a href="/enterData">
            <div class="card">
                <img src={escrituraImg} alt="Escritura Reflectiva" />
                <div class="card-text">
                    <h3>Escritura Reflectiva</h3>
                    <p>Expresión escrita de experiencias y insights.</p>
                </div>
            </div>
        </a>
        <a href="/stats">
            <div class="card">
                <img src={trackerImg} alt="Tracker de Habitos" />
                <div class="card-text">
                    <h3>Tracker de Hábitos</h3>
                    <p>Seguimiento y análisis de patrones de comportamiento.</p>
                </div>
            </div>
        </a>
    </div>
</div>