---
import '../styles/global.css'
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';

interface Props {
  title?: string;
}

const { title = "Psychonaut Log - Bitacora de un psiconauta" } = Astro.props;
const apiBase = import.meta.env.VITE_API_BASE || "";
---
<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />	
		<meta name="viewport" content="width=device-width" />
		<meta name="api-base" content={apiBase} />
		<title>{title}</title>
		
		<link rel="icon" type="image/png" href="/psychonaut_log-icon.png" />
		<link rel="icon" href="/assets/psychonaut_log-icon.png" />
		<meta name="description" content="Herramienta de registro y analisis de practicas psiconauticas" />
		<meta name="twitter:card" content="summary_large_image">
	</head>
	<body>
		<Header />
		<main>
			<slot />
			<Hero />
		</main>
		<Footer />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		background: #010207;
		color: #fefefe;
	}
	main {
		min-height: 100vh;
	}
</style>
