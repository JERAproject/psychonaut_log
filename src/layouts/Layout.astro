---
import '../styles/global.css'
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BottomNav from '../components/BottomNav.astro';
import Hero from '../components/Hero.astro';
import SuccessPopup from '../components/SuccessPopup.jsx';

interface Props {
  title?: string; 
  description?: string;
  image?: string;
}

const { 
  title = "Psychonaut Log - Bitácora de un psiconauta", 
  description = "Herramienta de registro y análisis de prácticas psiconáuticas. Registra tus experiencias, insights y reflexiones de meditación, visualización y autoindagación.",
  image = "/images/brain2.webp"
} = Astro.props;
const apiBase = import.meta.env.VITE_API_BASE || "";
const canonicalURL = new URL(Astro.url.pathname, Astro.site || Astro.url.origin);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="api-base" content={apiBase} />
    
    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url.origin).toString()} />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.url.origin).toString()} />
    
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    
    <!-- Theme color -->
    <meta name="theme-color" content="#010207" />
    
    <!-- Preconnect to external domains -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    
    <!-- Skip link for accessibility -->
    <style>
      .skip-link {
        position: absolute;
        top: -40px;
        left: 0;
        background: #5b8ff9;
        color: white;
        padding: 8px 16px;
        z-index: 1000;
        text-decoration: none;
        border-radius: 0 0 8px 0;
      }
      .skip-link:focus {
        top: 0;
      }
    </style>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Saltar al contenido principal</a>
    <Header />
    <main id="main-content" class="main-content">
      <slot />
      <Hero />
    </main>
    <Footer />
    <BottomNav />
    <SuccessPopup client:load />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    max-width: 100vw;
    height: 100%;
    background: #010207;
    color: #fefefe;
    font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  *, *::before, *::after {
    box-sizing: border-box;
  }

  main {
    min-height: 100vh;
  }

  .main-content {
    padding: 1rem;
    padding-left: max(1rem, env(safe-area-inset-left));
    padding-right: max(1rem, env(safe-area-inset-right));
    padding-bottom: max(1rem, env(safe-area-inset-bottom));
    width: 100%;
    max-width: 100%;
    overflow-x: hidden;
  }

  @media (max-width: 767px) {
    .main-content {
      padding-bottom: 5rem;
    }
  }

  @media (min-width: 640px) {
    .main-content {
      padding: 1.5rem;
    }
  }

  @media (min-width: 768px) {
    .main-content {
      padding: 2rem;
    }
  }

  :root {
    --font-size-xs: 0.75rem;
    --font-size-sm: 0.875rem;
    --font-size-base: 1rem;
    --font-size-lg: 1.125rem;
    --font-size-xl: 1.25rem;
    --font-size-2xl: 1.5rem;
    --font-size-3xl: 2rem;
    --font-size-4xl: 2.5rem;
    --font-size-5xl: 3rem;

    --space-xs: 0.25rem;
    --space-sm: 0.5rem;
    --space-md: 1rem;
    --space-lg: 1.5rem;
    --space-xl: 2rem;
    --space-2xl: 3rem;

    --radius-sm: 0.375rem;
    --radius-md: 0.5rem;
    --radius-lg: 0.75rem;
    --radius-xl: 1rem;
    --radius-2xl: 1.25rem;
    --radius-full: 9999px;

    --color-primary: #5b8ff9;
    --color-primary-dark: #2563eb;
    --color-bg: #010207;
    --color-bg-elevated: #1a1a2e;
    --color-bg-card: #16162a;
    --color-border: #2a2a35;
    --color-text: #fefefe;
    --color-text-muted: #9ca3af;
    --color-text-dim: #6b7280;
  }

  button.action-btn {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background: linear-gradient(90deg, #2563eb, #7c3aed);
    border-radius: 999px;
    color: white;
    text-decoration: none;
    font-size: 1rem;
    font-weight: 700;
    box-shadow: 0 0 20px rgba(59, 130, 246, 0.25);
    border: none;
    cursor: pointer;
    transition: transform 0.1s, box-shadow 0.1s;
    margin: 0.5rem;
  }
</style>