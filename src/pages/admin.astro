---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <div id="admin-root"></div>
</Layout>

<script>
  const API_BASE = '';
  const TOKEN_KEY = 'psy_token';
  const USER_KEY = 'psy_user';

  interface User { id: number; username: string; role: string; created_at: string; }
  interface CurrentUser { id: number; username: string; role: string; }

  function getToken(): string | null { return localStorage.getItem(TOKEN_KEY); }
  function getUser(): CurrentUser | null {
    const u = localStorage.getItem(USER_KEY);
    return u ? JSON.parse(u) : null;
  }
  function apiFetch(path: string, opts: RequestInit = {}) {
    const token = getToken();
    return fetch(`${API_BASE}${path}`, {
      ...opts,
      headers: {
        'Content-Type': 'application/json',
        ...(token ? { Authorization: `Bearer ${token}` } : {}),
        ...opts.headers
      }
    });
  }

  const root = document.getElementById('admin-root')!;
  render();

  function render() {
    const user = getUser();
    if (!user || user.role !== 'admin') {
      root.innerHTML = `<div class="admin-container">
        <div class="admin-unauthorized">
          <h2>Acceso denegado</h2>
          <p>Solo administradores pueden acceder a esta página.</p>
          <a href="/" class="btn">Volver al inicio</a>
        </div>
      </div>`;
      return;
    }
    root.innerHTML = `
      <div class="admin-container">
        <div class="admin-header">
          <div>
            <h1 class="admin-title">Panel de Administración</h1>
            <p class="admin-subtitle">Gestión de usuarios del sistema</p>
          </div>
          <div class="admin-user-info">
            Conectado como <strong>${user.username}</strong> (${user.role})
          </div>
        </div>

        <div class="admin-tabs">
          <button class="tab-btn active" data-tab="users">Usuarios</button>
          <button class="tab-btn" data-tab="psicologo">Asignar Psicólogos</button>
        </div>

        <div id="tab-users" class="tab-panel">
          <div class="admin-create-section">
          <h2>Crear nuevo usuario</h2>
          <form id="create-form" class="create-form">
            <div class="form-row">
              <label class="form-label">
                Username
                <input type="text" name="username" class="form-input" placeholder="Nombre de usuario" required minlength="2" maxlength="30" />
              </label>
              <label class="form-label">
                Password
                <input type="password" name="password" class="form-input" placeholder="Contraseña inicial" required minlength="4" />
              </label>
              <label class="form-label">
                Rol
                <select name="role" class="form-select">
                  <option value="user">Usuario</option>
                  <option value="psicologo">Psicólogo</option>
                  <option value="admin">Administrador</option>
                </select>
              </label>
              <button type="submit" class="btn btn-create">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                  Crear usuario
                </button>
            </div>
            <div id="create-error" class="form-error"></div>
            <div id="create-success" class="form-success"></div>
          </form>
        </div>

        <div class="admin-list-section">
          <h2>Usuarios registrados</h2>
          <div id="users-list"></div>
          <div id="list-loading" class="loading">Cargando...</div>
        </div>
        </div>

        <div id="tab-psicologo" class="tab-panel" style="display:none;">
          <div class="admin-list-section">
            <h2>Asignar Usuarios a Psicólogos</h2>
            <p class="section-hint">Seleccioná qué pacientes puede ver cada psicólogo en su bitácora.</p>
            <div id="psicologo-assignments"></div>
            <div id="assign-loading" class="loading">Cargando...</div>
          </div>
        </div>
      </div>

      <div id="edit-modal" class="modal-overlay hidden" role="dialog" aria-modal="true">
        <div class="modal admin-modal">
          <div class="modal-header">
            <h3 id="edit-modal-title">Editar usuario</h3>
            <button id="close-edit-modal" class="modal-close-btn">&times;</button>
          </div>
          <form id="edit-form" class="edit-form">
            <input type="hidden" name="userId" />
            <div class="form-group">
              <label class="form-label">Nueva contraseña <span class="label-hint">(dejar vacío para no cambiar)</span>
                <input type="password" name="password" class="form-input" placeholder="Nueva contraseña" minlength="4" />
              </label>
            </div>
            <div class="form-group">
              <label class="form-label">Rol
                <select name="role" class="form-select">
                  <option value="user">Usuario</option>
                  <option value="psicologo">Psicólogo</option>
                  <option value="admin">Administrador</option>
                </select>
              </label>
            </div>
            <div id="edit-error" class="form-error"></div>
            <div class="form-actions">
              <button type="button" id="cancel-edit" class="btn btn-cancel">Cancelar</button>
              <button type="submit" class="btn btn-save">Guardar cambios</button>
            </div>
          </form>
        </div>
      </div>
    `;
    attachEvents();
    loadUsers();
    loadPsicologoAssignments();
  }

  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const tab = (btn as HTMLButtonElement).dataset.tab!;
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.tab-panel').forEach(p => (p as HTMLElement).style.display = 'none');
      btn.classList.add('active');
      (document.getElementById(`tab-${tab}`) as HTMLElement).style.display = 'block';
    });
  });

  function attachEvents() {
    document.getElementById('create-form')?.addEventListener('submit', handleCreate);
    document.getElementById('edit-form')?.addEventListener('submit', handleEdit);
    document.getElementById('close-edit-modal')?.addEventListener('click', closeEditModal);
    document.getElementById('cancel-edit')?.addEventListener('click', closeEditModal);
    document.getElementById('edit-modal')?.addEventListener('click', (e) => {
      if (e.target === e.currentTarget) closeEditModal();
    });
  }

  async function handleCreate(e: Event) {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const fd = new FormData(form);
    const payload = {
      username: fd.get('username') as string,
      password: fd.get('password') as string,
      role: fd.get('role') as string
    };
    const errEl = document.getElementById('create-error')!;
    const succEl = document.getElementById('create-success')!;
    errEl.textContent = '';
    succEl.textContent = '';
    try {
      const res = await apiFetch('/api/admin/users', {
        method: 'POST',
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (!res.ok) { errEl.textContent = data.error || 'Error creando usuario'; return; }
      succEl.textContent = 'Usuario creado correctamente';
      form.reset();
      loadUsers();
    } catch {
      errEl.textContent = 'Error de conexión';
    }
  }

  async function loadUsers() {
    const listEl = document.getElementById('users-list')!;
    const loadingEl = document.getElementById('list-loading')!;
    loadingEl.style.display = 'block';
    listEl.innerHTML = '';
    try {
      const res = await apiFetch('/api/admin/users');
      if (!res.ok) { listEl.innerHTML = '<p class="form-error">Error cargando usuarios</p>'; loadingEl.style.display = 'none'; return; }
      const users: User[] = await res.json();
      loadingEl.style.display = 'none';
      const currentUser = getUser();
      listEl.innerHTML = `
        <div class="users-table-wrap">
          <table class="users-table">
            <thead>
              <tr>
                <th>Username</th>
                <th>Rol</th>
                <th>Fecha de creación</th>
                <th>Acciones</th>
              </tr>
            </thead>
            <tbody>
              ${users.map(u => `
                <tr>
                  <td class="td-username">${u.username}</td>
                  <td><span class="role-badge role-${u.role}">${u.role}</span></td>
                  <td class="td-date">${new Date(u.created_at).toLocaleDateString('es-ES', { year: 'numeric', month: 'short', day: 'numeric' })}</td>
                  <td class="td-actions">
                    ${u.id !== currentUser?.id ? `
                      <button class="btn-icon btn-edit" data-id="${u.id}" data-username="${u.username}" data-role="${u.role}" title="Editar">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                      </button>
                      <button class="btn-icon btn-delete" data-id="${u.id}" data-username="${u.username}" title="Eliminar">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                      </button>
                    ` : '<span class="self-label">Tú</span>'}
                  </td>
                </tr>
              `).join('')}
            </tbody>
          </table>
        </div>
      `;
      listEl.querySelectorAll('.btn-edit').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const el = e.currentTarget as HTMLButtonElement;
          openEditModal(Number(el.dataset.id), el.dataset.username!, el.dataset.role!);
        });
      });
      listEl.querySelectorAll('.btn-delete').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          const el = e.currentTarget as HTMLButtonElement;
          const id = Number(el.dataset.id);
          const username = el.dataset.username!;
          if (!confirm(`¿Eliminar al usuario "${username}"? Esta acción no se puede deshacer.`)) return;
          const res = await apiFetch(`/api/admin/users/${id}`, { method: 'DELETE' });
          if (res.ok) {
            loadUsers();
          } else {
            const data = await res.json();
            alert(data.error || 'Error eliminando usuario');
          }
        });
      });
    } catch {
      listEl.innerHTML = '<p class="form-error">Error de conexión</p>';
      loadingEl.style.display = 'none';
    }
  }

  function openEditModal(id: number, username: string, role: string) {
    const modal = document.getElementById('edit-modal')!;
    (document.getElementById('edit-modal-title') as HTMLElement).textContent = `Editar: ${username}`;
    (document.querySelector('#edit-form input[name="userId"]') as HTMLInputElement).value = String(id);
    (document.querySelector('#edit-form select[name="role"]') as HTMLSelectElement).value = role;
    (document.querySelector('#edit-form input[name="password"]') as HTMLInputElement).value = '';
    (document.getElementById('edit-error') as HTMLElement).textContent = '';
    modal.classList.remove('hidden');
  }

  function closeEditModal() {
    document.getElementById('edit-modal')?.classList.add('hidden');
  }

  async function handleEdit(e: Event) {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const fd = new FormData(form);
    const id = fd.get('userId') as string;
    const payload: Record<string, string> = {};
    const pw = fd.get('password') as string;
    const role = fd.get('role') as string;
    if (pw) payload.password = pw;
    if (role) payload.role = role;
    const errEl = document.getElementById('edit-error')!;
    errEl.textContent = '';
    try {
      const res = await apiFetch(`/api/admin/users/${id}`, {
        method: 'PATCH',
        body: JSON.stringify(payload)
      });
      if (!res.ok) {
        const data = await res.json();
        errEl.textContent = data.error || 'Error actualizando';
        return;
      }
      closeEditModal();
      loadUsers();
    } catch {
      errEl.textContent = 'Error de conexión';
    }
  }

  async function loadPsicologoAssignments() {
    const container = document.getElementById('psicologo-assignments')!;
    const loading = document.getElementById('assign-loading')!;
    loading.style.display = 'block';
    container.innerHTML = '';
    try {
      const res = await apiFetch('/api/psicologo/users');
      if (!res.ok) { container.innerHTML = '<p class="form-error">Error cargando</p>'; loading.style.display = 'none'; return; }
      const data: { psicologos: any[]; users: any[]; assignments: Record<number, number[]> } = await res.json();
      loading.style.display = 'none';

      const psicologos = data.psicologos;
      const users = data.users;

      if (psicologos.length === 0) {
        container.innerHTML = '<p class="hint-text">No hay psicólogos registrados.</p>';
        return;
      }

      container.innerHTML = `
        <div class="assign-table-wrap">
          <table class="assign-table">
            <thead>
              <tr>
                <th>Usuario</th>
                <th>Estado</th>
                ${psicologos.map(p => `<th class="th-psicologo">${p.username}</th>`).join('')}
              </tr>
            </thead>
            <tbody>
              ${users.map(u => {
                const assignedTo = psicologos.filter(p => data.assignments[p.id]?.includes(u.id));
                const statusText = assignedTo.length === 0 ? 'Sin asignar' : assignedTo.map(p => p.username).join(', ');
                const statusClass = assignedTo.length === 0 ? 'status-none' : 'status-assigned';
                return `<tr>
                  <td class="td-user">${u.username}</td>
                  <td class="td-status"><span class="status-badge ${statusClass}">${statusText}</span></td>
                  ${psicologos.map(p => {
                    const isAssigned = data.assignments[p.id]?.includes(u.id);
                    return `<td class="td-assign">
                      <button type="button"
                        class="assign-btn ${isAssigned ? 'assigned' : ''}"
                        data-pid="${p.id}" data-uid="${u.id}" data-assigned="${isAssigned}"
                        title="${isAssigned ? 'Desasignar de ' + p.username : 'Asignar a ' + p.username}">
                        ${isAssigned ? '✓' : '–'}
                      </button>
                    </td>`;
                  }).join('')}
                </tr>`;
              }).join('')}
            </tbody>
          </table>
        </div>
      `;

      container.querySelectorAll('.assign-btn').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          const el = e.currentTarget as HTMLButtonElement;
          const pid = Number(el.dataset.pid);
          const uid = Number(el.dataset.uid);
          const isAssigned = el.dataset.assigned === 'true';
          const endpoint = isAssigned ? '/api/psicologo/unassign' : '/api/psicologo/assign';
          const res = await apiFetch(endpoint, {
            method: 'POST',
            body: JSON.stringify({ psicologoId: pid, userId: uid })
          });
          if (res.ok) loadPsicologoAssignments();
          else { const d = await res.json(); alert(d.error || 'Error'); }
        });
      });
    } catch {
      container.innerHTML = '<p class="form-error">Error de conexión</p>';
      loading.style.display = 'none';
    }
  }
</script>

<style>
  .admin-container {
    max-width: 900px;
    margin: auto;
    padding: 1.5rem 1rem;
    min-height: 100vh;
    background: #050505;
    color: #fff;
  }

  @media (min-width: 640px) {
    .admin-container {
      padding: 2rem 1.5rem;
    }
  }

  .admin-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }

  .admin-title {
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    font-weight: 700;
    margin: 0 0 0.5rem;
    background: linear-gradient(135deg, #fefefe 0%, #fbbf24 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .admin-subtitle { color: rgba(255,255,255,0.55); font-size: 0.9rem; margin: 0; }

  .admin-user-info {
    font-size: 0.8rem;
    color: rgba(255,255,255,0.55);
    padding: 0.5rem 0.75rem;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 8px;
  }

  .admin-unauthorized {
    text-align: center;
    padding: 4rem 2rem;
    color: rgba(255,255,255,0.55);
  }
  .admin-unauthorized h2 { color: #fff; margin-bottom: 0.5rem; }

  .admin-create-section, .admin-list-section {
    background: linear-gradient(145deg, #12121a 0%, #0d0d14 100%);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 16px;
    padding: 1.25rem;
    margin-bottom: 1.5rem;
  }

  @media (min-width: 640px) {
    .admin-create-section, .admin-list-section {
      padding: 1.5rem;
    }
  }

  .admin-create-section h2, .admin-list-section h2 {
    font-size: 0.9rem;
    font-weight: 700;
    color: #fbbf24;
    margin: 0 0 1rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .admin-create-section h2::before, .admin-list-section h2::before {
    content: '';
    display: inline-block;
    width: 4px;
    height: 16px;
    background: linear-gradient(180deg, #fbbf24 0%, #f59e0b 100%);
    border-radius: 2px;
  }

  .form-row {
    display: flex;
    gap: 0.75rem;
    align-items: flex-end;
    flex-wrap: wrap;
  }

  .form-label {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    color: rgba(255,255,255,0.7);
    font-size: 0.8rem;
    flex: 1;
    min-width: 150px;
  }

  .label-hint { font-size: 0.72rem; color: rgba(255,255,255,0.4); }

  .form-input, .form-select {
    padding: 0.6rem 0.75rem;
    background: rgba(0,0,0,0.4);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 8px;
    color: #fff;
    font-size: 0.85rem;
    font-family: inherit;
    outline: none;
    transition: all 0.15s;
  }

  .form-input:focus, .form-select:focus {
    border-color: #fbbf24;
    box-shadow: 0 0 0 2px rgba(251, 191, 36, 0.15);
  }

  .btn {
    padding: 0.5rem 1rem;
    border: none;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s;
    text-decoration: none;
    display: inline-block;
    font-family: inherit;
  }

  .btn-create {
    background: linear-gradient(135deg, #f59e0b 0%, #fbbf24 100%);
    color: #000;
    padding: 0.6rem 1.25rem;
    align-self: flex-end;
    box-shadow: 0 0 15px rgba(251, 191, 36, 0.2);
  }
  .btn-create:hover { 
    background: linear-gradient(135deg, #fbbf24 0%, #fcd34d 100%);
    transform: translateY(-1px);
    box-shadow: 0 0 20px rgba(251, 191, 36, 0.3);
  }

  .btn-create svg {
    margin-right: 0.4rem;
    vertical-align: middle;
  }

  .btn-icon svg {
    display: block;
  }

  .btn-cancel { background: rgba(255,255,255,0.08); color: rgba(255,255,255,0.7); }
  .btn-cancel:hover { background: rgba(255,255,255,0.12); }
  .btn-save { background: linear-gradient(135deg, #f59e0b 0%, #fbbf24 100%); color: #000; }
  .btn-save:hover { background: linear-gradient(135deg, #fbbf24 0%, #fcd34d 100%); }

  .form-error { color: #f87171; font-size: 0.82rem; margin-top: 0.5rem; min-height: 1.2em; }
  .form-success { color: #34d399; font-size: 0.82rem; margin-top: 0.5rem; min-height: 1.2em; }

  .loading { color: rgba(255,255,255,0.55); font-size: 0.85rem; margin: 1rem 0; }
  .loading[style*="display: none"] { display: none; }

  .users-table-wrap { overflow-x: auto; }

  .users-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
  }

  .users-table th {
    text-align: left;
    color: rgba(255,255,255,0.55);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.75rem;
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }

  .users-table td {
    padding: 0.75rem;
    color: rgba(255,255,255,0.85);
    border-bottom: 1px solid rgba(255,255,255,0.04);
  }

  .users-table tr:last-child td { border-bottom: none; }
  .users-table tr:hover td { background: rgba(255,255,255,0.03); }

  .td-username { font-weight: 600; color: #fff; }
  .td-date { color: rgba(255,255,255,0.55); white-space: nowrap; }

  .role-badge {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    border-radius: 12px;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .role-admin { background: rgba(239,68,68,0.15); color: #fca5a5; border: 1px solid rgba(239,68,68,0.25); }
  .role-psicologo { background: rgba(251,191,36,0.15); color: #fcd34d; border: 1px solid rgba(251,191,36,0.25); }
  .role-user { background: rgba(59,130,246,0.15); color: #93c5fd; border: 1px solid rgba(59,130,246,0.25); }

  .btn-icon {
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 6px;
    color: rgba(255,255,255,0.55);
    cursor: pointer;
    padding: 0.4rem 0.6rem;
    font-size: 0.9rem;
    transition: all 0.15s;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .btn-icon:hover { border-color: #fbbf24; color: #fbbf24; }
  .btn-delete:hover { border-color: #f87171; color: #f87171; }

  .self-label { color: rgba(255,255,255,0.4); font-size: 0.78rem; font-style: italic; }

  .td-actions { white-space: nowrap; }

  .modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.7);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 100;
    backdrop-filter: blur(8px);
  }

  .modal-overlay.hidden { display: none; }

  .admin-modal {
    background: linear-gradient(145deg, #12121a 0%, #0d0d14 100%);
    border: 1px solid rgba(251,191,36,0.2);
    border-radius: 16px;
    padding: 1.5rem;
    width: 90%;
    max-width: 420px;
    box-shadow: 0 0 30px rgba(251, 191, 36, 0.1);
  }

  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }

