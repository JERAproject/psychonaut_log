---
import Layout from '../layouts/Layout.astro';

// Aquí podrías añadir lógica para procesar el formulario en el servidor (Astro Actions)
---

<Layout title="Registrar Sesión | PsychonautLog">
  <main class="container">
    <header>
      <h1>Nueva Entrada de Bitácora</h1>
      <p>Registra los parámetros de tu exploración fenomenológica.</p>
    </header>
    <div class="container">
      <form method="POST" class="data-form">
        <fieldset>
          <legend>Metadatos de la Sesión</legend>
          <div class="grid">
            <label>
              Fecha
              <input type="date" name="fecha" required />
            </label>
            <label>
              Hora
              <input type="time" name="hora" required />
            </label>
            <label>
              Duración (min)
              <input type="number" name="duracion" min="1" placeholder="Ej: 20" required />
            </label>
          </div>

          <label>
            Tipo de Práctica
            <select name="tipo_practica" required>
              <option value="mindfulness">Mindfulness</option>
              <option value="trataka">Trataka</option>
              <option value="visualizacion">Visualización Guiada</option>
              <option value="shambhavi">Third Eye Gazing (Shambhavi)</option>
              <option value="escritura">Escritura Reflectiva</option>
            </select>
          </label>
        </fieldset>

        <fieldset>
          <legend>Fenomenología y Estado</legend>
          <label>
            Estado Previo
            <input type="text" name="estado_previo" placeholder="Ej: Dispersión analítica, fatiga..." required />
          </label>
          <label>
            Fenomenología (Observación directa)
            <input type="text" name="fenomenologia" placeholder="Ej: Fosfenos, presión en entrecejo..." required />
          </label>
          <label>
            Descripción Detallada (Cuerpo)
            <textarea name="cuerpo" rows="6" placeholder="Describe el flujo de la experiencia..."></textarea>
          </label>
        </fieldset>

        <fieldset>
          <legend>Análisis e Integración</legend>
          <label>
            Insight Principal
            <input type="text" name="insight" placeholder="¿Qué descubriste hoy?" />
          </label>
          <label>
            Plan de Integración
            <input type="text" name="integracion" placeholder="Acción concreta para el día..." />
          </label>
          <label>
            Estado Post-Práctica
            <input type="text" name="estado_post" placeholder="Ej: Ecuanimidad, vitalidad..." required />
          </label>
        </fieldset>

        <button type="submit" class="submit-btn">Guardar en Bitácora</button>
      </form>
    </div>
  </main>
</Layout>

<style>
  .container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
    align-items: start;
    max-width: 100%;
    margin: 2rem auto;
    padding: 1rem;
    font-family: 'Inter', system-ui, sans-serif;
  }

  header {
    margin-bottom: 100px;
    padding-bottom: 0;
    display: none;
    flex-direction: column;
    align-items: center;
    padding: 1rem;
  }

  header h1 {
    margin-top: 0;
    font-size: clamp(1.75rem, 2.5vw, 2.5rem);
  }

  header p {
    margin: 0.75rem 0 0;
    line-height: 1.6;
    max-width: 42rem;
  }

  .data-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
  }

  fieldset {
    border: 1px solid #ddd;
    border-radius: 16px;
    padding: 3.5rem;
    background: #111827;
  }

  legend {
    font-weight: 700;
    padding: 0 0.5rem;
    color: #fafafa;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1rem;
  }

  label {
    display: block;
    margin-bottom: 1rem;
    font-size: 0.95rem;
    font-weight: 500;
    color: #fafafa;
  }

  input,
  select,
  textarea {
    width: 100%;
    padding: 0.8rem;
    margin-top: 0.4rem;
    border: 1px solid #ccc;
    border-radius: 10px;
    font-size: 1rem;
    background: #fff;
    box-sizing: border-box;
  }

  textarea {
    resize: vertical;
    min-height: 8rem;
  }

  .submit-btn {
    width: 100%;
    background-color: #111;
    color: #fff;
    padding: 1rem 1.25rem;
    border: none;
    border-radius: 12px;
    font-size: 1.05rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .submit-btn:hover {
    background-color: #333;
    transform: translateY(-1px);
  }

  @media (max-width: 900px) {
    .container {
      grid-template-columns: 1fr;
      padding: 0 0.75rem;
      gap: 1.5rem;
    }

    fieldset {
      padding: 1.25rem;
    }
  }

  @media (max-width: 640px) {
    .container {
      margin: 1.25rem auto;
    }

    header h1 {
      font-size: 1.9rem;
    }

    label {
      font-size: 0.94rem;
    }

    input,
    select,
    textarea {
      padding: 0.85rem;
    }

    .submit-btn {
      padding: 0.95rem;
      font-size: 1rem;
    }
  }
</style>