---
import Layout from "../layouts/Layout.astro";
import HabitTracker from "../components/HabitTracker.jsx";
---

<Layout 
  title="Hábitos | PsychonautLog" 
  description="Registra y visualiza el progreso de tus hábitos diarios."
>
  <main class="habits-page">
    <header class="page-header">
      <h1>Hábitos</h1>
      <p class="subtitle">Registra y visualiza el progreso de tus hábitos</p>
    </header>

    <div class="tracker-wrapper">
      <HabitTracker client:load />
    </div>
  </main>
</Layout>

<style>
  .habits-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1.5rem 1rem;
    min-height: 100vh;
    background: #050505;
    color: #fff;
  }

  .page-header {
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .page-header h1 {
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    font-weight: 700;
    margin: 0 0 0.5rem;
    background: linear-gradient(135deg, #fefefe 0%, #a5b4fc 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .subtitle {
    color: rgba(255,255,255,0.55);
    font-size: clamp(0.9rem, 2vw, 1.1rem);
    margin: 0;
  }

  .tracker-wrapper {
    width: 100%;
  }
</style>