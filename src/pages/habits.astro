---
import Layout from "../layouts/Layout.astro";
import HabitForm from "../components/HabitForm.astro";
import HabitDashboard from "../components/HabitDashboard.jsx";
---

<Layout 
  title="Hábitos | PsychonautLog" 
  description="Haz seguimiento de tus hábitos diarios de práctica: meditación, escritura reflexiva, y más."
>
  <main class="habits-page">
    <header class="habits-header">
      <div class="header-content">
        <h1>Seguimiento de Hábitos</h1>
        <p class="subtitle">Registra tu práctica diaria</p>
      </div>
      <HabitForm />
    </header>
    <section class="dashboard-section" aria-label="Panel de hábitos">
      <HabitDashboard client:load />
    </section>
  </main>
</Layout>

<style>
  .habits-page {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 1rem;
    color: #fefefe;
  }

  .habits-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .header-content h1 {
    font-size: 1.75rem;
    margin: 0 0 0.25rem 0;
  }

  .subtitle {
    color: #888;
    margin: 0;
    font-size: 0.95rem;
  }

  .dashboard-section {
    background: #0d0d1a;
    border-radius: 16px;
    padding: 1.5rem;
    border: 1px solid #2a2a35;
    overflow-x: auto;
  }

  @media (max-width: 640px) {
    .habits-header {
      flex-direction: column;
    }

    .habits-page {
      padding: 1rem;
    }

    .dashboard-section {
      padding: 1rem;
    }
  }
</style>