---
import Layout from "../layouts/Layout.astro";
import HabitDashboard from "../components/HabitDashboard.jsx";
import HabitCalendar from "../components/HabitCalendar.jsx";

// Nota: Asegúrate de que estos componentes existan en tu carpeta /components/
---

<Layout 
  title="Hábitos | PsychonautLog" 
  description="Registra y visualiza el progreso de tus hábitos diarios de práctica."
>
  <main class="habits-page">
    <header class="page-header">
      <h1>Hábitos</h1>
      <p class="subtitle">Registra y visualiza tu práctica diaria</p>
    </header>

    <div class="tabs">
      <button class="tab-btn active" data-tab="seguimiento">Seguimiento</button>
      <button class="tab-btn" data-tab="resumen">Resumen</button>
    </div>

    <section id="seguimiento-tab" class="tab-content active">
      <div class="seguimiento-container">
        <!-- ESTADÍSTICAS EN TOP -->
        <div class="stats-section-top">
          <h2 class="section-title">Estadísticas</h2>
          <div class="stats-row-minimal">
            <div class="stat-mini">
              <span class="stat-value-mini" id="active-habits">—</span>
              <span class="stat-label-mini">Activos</span>
            </div>
            <div class="stat-mini">
              <span class="stat-value-mini" id="today-completed">—</span>
              <span class="stat-label-mini">Hoy</span>
            </div>
            <div class="stat-mini">
              <span class="stat-value-mini">90</span>
              <span class="stat-label-mini">Días</span>
            </div>
          </div>
        </div>

        <div class="weekly-section">
          <h2 class="section-title">Tu Día a Día</h2>
          <p class="section-subtitle">Registra tu práctica de esta semana</p>
          <div class="dashboard-wrapper">
            <!-- Hidratación del componente React -->
            <HabitDashboard client:load />
          </div>
        </div>

        <div class="grid-section">
          <h2 class="section-title">Historial Reciente</h2>
          <p class="section-subtitle">Últimas 4 semanas</p>
          <div id="grid-view" class="grid-view">
            <div class="loading-msg">Cargando historial...</div>
          </div>
        </div>
      </div>
    </section>

    <section id="resumen-tab" class="tab-content">
      <div class="resumen-container">
        <div class="calendar-section">
          <h2 class="section-title">Calendario</h2>
          <p class="section-subtitle">Vista mensual</p>
          <div id="calendar-view" class="calendar-view">
            <!-- Hidratación del componente React para el calendario -->
            <HabitCalendar client:load />
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script is:inline>
  // Manejo de Tabs
  var tabs = document.querySelectorAll(".tab-btn");
  var contents = document.querySelectorAll(".tab-content");

  tabs.forEach(function(tab) {
    tab.addEventListener("click", function() {
      var target = tab.getAttribute("data-tab");
      tabs.forEach(function(t) { t.classList.remove("active"); });
      contents.forEach(function(c) { c.classList.remove("active"); });
      tab.classList.add("active");
      document.getElementById(target + "-tab").classList.add("active");

      if (target === "resumen") {
        loadResumen();
      }
    });
  });

  // Utilidades de Fecha (Configuración para Argentina)
  function getARGDate() {
    var now = new Date();
    var argDate = new Date(now.toLocaleString("en-US", { timeZone: "America/Argentina/Buenos_Aires" }));
    return argDate;
  }

  function getDates() {
    var dates = [];
    var today = getARGDate();
    for (var i = 89; i >= 0; i--) {
      var d = new Date(today);
      d.setDate(today.getDate() - i);
      dates.push(d.toISOString().split("T")[0]);
    }
    return dates;
  }

  function getWeekDates() {
    var dates = [];
    var today = getARGDate();
    var dayOfWeek = today.getDay();
    var monday = new Date(today);
    monday.setDate(today.getDate() - dayOfWeek);
    for (var i = 0; i < 7; i++) {
      var d = new Date(monday);
      d.setDate(monday.getDate() + i);
      dates.push({
        date: d.toISOString().split("T")[0],
        day: d.toLocaleDateString("es-ES", { weekday: "short" }).substring(0, 2)
      });
    }
    return dates;
  }

  // Carga de Estadísticas
  function getAuthHeaders() {
    var token = localStorage.getItem("psy_token");
    return token ? { Authorization: "Bearer " + token } : {};
  }

  async function loadResumen() {
    try {
      var [habitsRes, logsRes] = await Promise.all([
        fetch("/api/habits", { headers: getAuthHeaders() }),
        fetch("/api/logs", { headers: getAuthHeaders() })
      ]);

      var habits = await habitsRes.json();
      var logs = await logsRes.json();

      var todayStr = getARGDate().toISOString().split("T")[0];
      var todayLogs = logs.filter(function(l) { return l.logDate === todayStr; }).reduce(function(s, l) { return s + l.count; }, 0);

      document.getElementById("active-habits").textContent = String(habits.length);
      document.getElementById("today-completed").textContent = String(todayLogs);
    } catch (err) {
      console.error("Error cargando resumen:", err);
    }
  }

  // Carga del Grid de Historial - Diseño Mobile-First
  async function loadGrid() {
    try {
      var [habitsRes, logsRes] = await Promise.all([
        fetch("/api/habits", { headers: getAuthHeaders() }),
        fetch("/api/logs", { headers: getAuthHeaders() })
      ]);

      var habits = await habitsRes.json();
      var logs = await logsRes.json();

      var logMap = {};
      logs.forEach(function(l) { logMap[l.habitId + ":" + l.logDate] = l.count; });

      // Generar semanas (últimas 4 semanas) - ORDEN INVERSO (más reciente primero)
      var today = getARGDate();
      var weeks = [];
      // Ordenar: semana actual primero, luego las anteriores
      for (var w = 0; w >= 0; w--) {
        var weekDates = [];
        var weekStart = new Date(today);
        weekStart.setDate(today.getDate() - (w * 7 + 6));
        for (var d = 0; d < 7; d++) {
          var date = new Date(weekStart);
          date.setDate(weekStart.getDate() + d);
          var dateStr = date.toISOString().split("T")[0];
          var dayName = date.toLocaleDateString("es-ES", { weekday: "short" }).substring(0, 2).toUpperCase();
          weekDates.push({ date: dateStr, day: dayName });
        }
        weeks.push(weekDates);
      }
      // Agregar semanas anteriores en orden inverso
      for (var w = 1; w <= 3; w++) {
        var weekDates = [];
        var weekStart = new Date(today);
        weekStart.setDate(today.getDate() - (w * 7 + 6));
        for (var d = 0; d < 7; d++) {
          var date = new Date(weekStart);
          date.setDate(weekStart.getDate() + d);
          var dateStr = date.toISOString().split("T")[0];
          var dayName = date.toLocaleDateString("es-ES", { weekday: "short" }).substring(0, 2).toUpperCase();
          weekDates.push({ date: dateStr, day: dayName });
        }
        weeks.push(weekDates);
      }

      // Construcción del HTML - Diseño Compacto
      var gridHtml = '<div class="history-compact">';

      // Leyenda de hábitos
      gridHtml += '<div class="habit-legend">';
      habits.forEach(function(h) {
        gridHtml += '<div class="legend-item"><span class="legend-dot" style="background:' + h.color + '"></span>' + h.name + '</div>';
      });
      gridHtml += '</div>';

      // Semanas
      weeks.forEach(function(week, weekIndex) {
        var weekLabel = "Semana " + (weekIndex + 1);
        gridHtml += '<div class="history-week"><div class="week-header"><span class="week-label">' + weekLabel + '</span><span class="week-completed"></span></div><div class="week-days">';

        week.forEach(function(day) {
          var totalCount = 0;
          habits.forEach(function(h) {
            totalCount += (logMap[h.id + ":" + day.date] || 0);
          });
          var activeClass = totalCount > 0 ? "active" : "";
          var bgColor = totalCount > 0 ? habits[0].color : "";
          gridHtml += '<div class="day-item"><span class="day-label">' + day.day + '</span><div class="day-cell ' + activeClass + '" style="background-color:' + bgColor + '; opacity:' + (totalCount > 0 ? Math.min(totalCount / 3, 1) : 0) + '" title="' + day.date + ': ' + totalCount + ' entradas"></div></div>';
        });

        gridHtml += '</div></div>';
      });

      gridHtml += '</div>';
      document.getElementById("grid-view").innerHTML = gridHtml;
    } catch (err) {
      console.error("Error cargando grid:", err);
      document.getElementById("grid-view").innerHTML = '<p class="error-msg">Error al cargar historial.</p>';
    }
  }

  // Inicialización
  loadGrid();
</script>

<style>
  .habits-page {
    max-width: 1400px;
    margin: 0 auto;
    padding: 1.5rem 1rem;
    padding-left: max(1rem, env(safe-area-inset-left));
    padding-right: max(1rem, env(safe-area-inset-right));
    color: #fefefe;
  }

  @media (min-width: 640px) {
    .habits-page {
      padding: 2rem 1.5rem;
    }
  }

  .page-header {
    text-align: center;
    margin-bottom: 1.5rem;
  }

  @media (min-width: 640px) {
    .page-header {
      margin-bottom: 2rem;
    }
  }

  .page-header h1 {
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    font-weight: 700;
    margin: 0 0 0.5rem;
    background: linear-gradient(135deg, #fefefe 0%, #a5b4fc 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  @media (min-width: 640px) {
    .page-header h1 {
      margin-bottom: 0.75rem;
    }
  }

  .subtitle {
    color: #6b7280;
    font-size: clamp(1.25rem, 2.5vw, 1.1rem);
    margin: 0;
  }

  .tabs {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    background: #111827;
    padding: 0.35rem;
    border-radius: 12px;
    max-width: 400px;
    margin-left: auto;
    margin-right: auto;
  }

  @media (min-width: 640px) {
    .tabs {
      margin-bottom: 2rem;
    }
  }

  .tab-btn {
    flex: 1;
    padding: 0.75rem 0.5rem;
    background: transparent;
    border: none;
    border-radius: 10px;
    color: #9ca3af;
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
    min-height: 44px;
  }

  @media (min-width: 640px) {
    .tab-btn {
      padding: 0.75rem 1.25rem;
      font-size: 0.95rem;
    }
  }

  .tab-btn:hover {
    color: #d1d5db;
  }

  .tab-btn.active {
    background: #2563eb;
    color: #fff;
  }

  .tab-content {
    display: none;
  }

  .tab-content.active {
    display: block;
  }

  .seguimiento-container {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .seguimiento-container {
      gap: 2rem;
    }
  }

  /* ESTADÍSTICAS MINIMALISTAS EN TOP */
  .stats-section-top {
    background: linear-gradient(135deg, #16162a 0%, #1a1a2e 100%);
    border: 1px solid #2a2a35;
    border-radius: 12px;
    padding: 1rem;
  }

  @media (min-width: 640px) {
    .stats-section-top {
      padding: 1.25rem;
    }
  }

  .stats-row-minimal {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .stat-mini {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 1;
    padding: 0.5rem;
    background: rgba(91, 143, 249, 0.05);
    border-radius: 8px;
    border: 1px solid rgba(91, 143, 249, 0.1);
  }

  .stat-value-mini {
    font-size: clamp(1.25rem, 4vw, 1.5rem);
    font-weight: 700;
    color: #5b8ff9;
  }

  .stat-label-mini {
    font-size: 0.65rem;
    color: #6b7280;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: 0.25rem;
  }

  @media (min-width: 640px) {
    .stat-mini {
      padding: 0.75rem;
    }
    .stat-label-mini {
      font-size: 0.7rem;
    }
  }

  .section-title {
    font-size: clamp(1.25rem, 4vw, 1.5rem);
    font-weight: 600;
    color: #e5e7eb;
    margin: 0 0 0.4rem;
  }

  @media (min-width: 640px) {
    .section-title {
      margin: 0 0 0.5rem;
    }
  }

  .section-subtitle {
    font-size: clamp(0.8rem, 2vw, 0.9rem);
    color: #6b7280;
    margin: 0 0 1rem;
  }

  @media (min-width: 640px) {
    .section-subtitle {
      margin-bottom: 1.25rem;
    }
  }

  .dashboard-wrapper {
    background: linear-gradient(145deg, #16162a 0%, #1a1a2e 100%);
    border: 1px solid #2a2a35;
    border-radius: 12px;
    padding: 1rem;
  }

  @media (min-width: 640px) {
    .dashboard-wrapper {
      border-radius: 16px;
      padding: 1.25rem;
    }
  }

  .grid-view {
    background: linear-gradient(145deg, #16162a 0%, #1a1a2e 100%);
    border: 1px solid #2a2a35;
    border-radius: 12px;
    padding: 1rem;
    overflow-x: hidden;
  }

  @media (min-width: 640px) {
    .grid-view {
      border-radius: 16px;
      padding: 1rem;
      overflow-x: auto;
    }
  }

  .history-compact {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .history-week {
    background: #0d0d1a;
    border-radius: 10px;
    padding: 0.75rem;
  }

  .week-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #2a2a35;
  }

  .week-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: #a5b4fc;
  }

  .week-completed {
    font-size: 0.75rem;
    color: #6b7280;
  }

  .week-days {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 0.35rem;
  }

  .day-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
  }

  .day-label {
    font-size: 0.6rem;
    color: #6b7280;
  }

  .day-cell {
    width: 100%;
    aspect-ratio: 1;
    border-radius: 4px;
    background: #1e293b;
    cursor: pointer;
    transition: all 0.15s;
  }

  .day-cell:hover {
    transform: scale(1.1);
  }

  .day-cell.active {
    box-shadow: 0 0 6px currentColor;
  }

  .habit-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid #2a2a35;
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    color: #9ca3af;
  }

  .legend-dot {
    width: 10px;
    height: 10px;
    border-radius: 2px;
  }

  .resumen-container {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .resumen-container {
      gap: 2rem;
    }
  }

  .calendar-view {
    background: linear-gradient(145deg, #16162a 0%, #1a1a2e 100%);
    border: 1px solid #2a2a35;
    border-radius: 12px;
    padding: 1rem;
  }

  @media (min-width: 640px) {
    .calendar-view {
      border-radius: 16px;
      padding: 1.5rem;
    }
  }

  .calendar-month {
    margin-bottom: 1.5rem;
  }

  .calendar-month:last-child {
    margin-bottom: 0;
  }

  @media (min-width: 640px) {
    .calendar-month {
      margin-bottom: 2rem;
    }
  }

  .month-title {
    font-size: 1rem;
    font-weight: 600;
    color: #e5e7eb;
    margin: 0 0 0.75rem;
  }

  @media (min-width: 640px) {
    .month-title {
      font-size: 1.1rem;
      margin-bottom: 1rem;
    }
  }

  .calendar-container {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .calendar-container {
      gap: 2rem;
    }
  }

  .stats-cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
    margin-top: 0.75rem;
  }

  @media (min-width: 640px) {
    .stats-cards {
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: 1rem;
      margin-top: 1rem;
    }
  }

  .stat-card {
    background: linear-gradient(145deg, #16162a 0%, #1a1a2e 100%);
    border: 1px solid #2a2a35;
    border-radius: 12px;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
  }

  @media (min-width: 640px) {
    .stat-card {
      border-radius: 16px;
      padding: 1.5rem;
      gap: 0.5rem;
    }
  }

  .stat-value {
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 700;
    color: #5b8ff9;
  }

  .stat-label {
    font-size: 0.7rem;
    color: #6b7280;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-align: center;
  }

  @media (min-width: 640px) {
    .stat-label {
      font-size: 0.8rem;
    }
  }

  .loading-msg {
    text-align: center;
    color: #666;
    padding: 2rem;
  }

  .error-msg {
    text-align: center;
    color: #f87171;
    padding: 2rem;
  }

  @media (min-width: 768px) {
    .dashboard-wrapper,
    .grid-view,
    .calendar-view {
      padding: 1.25rem;
    }

    .stats-cards {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>