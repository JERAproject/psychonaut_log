---
import Layout from '../layouts/Layout.astro';
import NetworkGraph from '../components/NetworkGraph.astro';
import About from '../pages/about.astro';
import Contact from '../pages/contact.astro';
// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<Layout>

<div class="hero">
        <h1 class="hero-title">PsychonautLog</h1>
        <h2 class="hero-subtitle">Bitácora psiconauta</h2>
        <NetworkGraph>
          <p>Esta bitacora es un registro de las experiencias y descubrimientos de un psiconauta en su viaje de exploración mental.<br><br>
          <br> Aquí se documentan las prácticas, insights y reflexiones obtenidas a través de diversas técnicas de meditación, visualización y autoindagación.<br><br>
          <br>El objetivo es observar los pensamientos y emociones a medida que evolucionan en el tiempo, buscar los patrones subyacentes y comprender la naturaleza de nuestra mente.</p>
        </NetworkGraph>
    </div>

    <About />
    <!-- <div class="bottom actions">
        <a href="  ja689/journal#entradas-guardadas" class="primary-btn">
        📓 Entradas Guardadas
        </a>
    </div> -->
    <Contact />

</Layout>

<style>
    .hero {
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      padding: 3rem 1rem;
      padding-bottom: max(3rem, env(safe-area-inset-bottom));
      min-height: calc(100vh - 200px);
      gap: 1.5rem;
    }

    .hero-title {
      font-size: clamp(1.75rem, 8vw, 3rem);
      font-weight: 700;
      margin: 0;
      background: linear-gradient(135deg, #fefefe 0%, #a5b4fc 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      line-height: 1.2;
    }

    .hero-subtitle {
      font-size: clamp(0.875rem, 3vw, 1.125rem);
      font-weight: 500;
      margin: 0;
      color: #9ca3af;
    }

    .graph-overlay {
      position: relative;
      width: 100%;
      max-width: 100%;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .graph-overlay-text {
      font-size: clamp(0.8rem, 2.5vw, 0.95rem);
      line-height: 1.6;
      color: #d1d5db;
      text-align: left;
      margin: 0;
      padding: 1rem;
      background: rgba(22, 22, 42, 0.8);
      border-radius: 12px;
      border: 1px solid rgba(42, 42, 53, 0.5);
    }

    @media (min-width: 768px) {
      .hero {
        padding: 4rem 2rem;
        gap: 2rem;
      }

      .hero-title {
        font-size: clamp(2.5rem, 6vw, 4rem);
      }

      .hero-subtitle {
        font-size: clamp(1rem, 2vw, 1.25rem);
      }


    }

    @media (min-width: 1024px) {
      .graph-overlay {
        right: 3rem;
        max-width: 30vw;
      }
    }

    @media (min-width: 1280px) {
      .graph-overlay {
        right: 5rem;
        max-width: 25vw;
      }
    }

    .bottom {
      position: fixed;
      bottom: max(1rem, env(safe-area-inset-bottom));
      left: 50%;
      transform: translateX(-50%);
      z-index: 10;
      width: calc(100% - 2rem);
      max-width: 400px;
    }

    .actions {
      text-align: center;
    }

    .primary-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      padding: 1rem 1.5rem;
      background: linear-gradient(135deg, #2563eb, #7c3aed);
      border-radius: 999px;
      color: white;
      text-decoration: none;
      font-size: 0.95rem;
      font-weight: 700;
      box-shadow: 0 4px 15px rgba(59, 130, 246, 0.3);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
      min-height: 52px;
    }

    .primary-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(59, 130, 246, 0.4);
    }

    .primary-btn:active {
      transform: translateY(0);
    }

    @media (min-width: 640px) {
      .primary-btn {
        padding: 1.2rem 2.5rem;
        font-size: 1.1rem;
        width: auto;
      }
    }
</style>