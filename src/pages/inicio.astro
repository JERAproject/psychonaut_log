---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="landing-hero">
    <h1 class="landing-title">PsychonautLog</h1>
    <h2 class="landing-subtitle">Bitácora de un psiconauta</h2>
    
    <div class="landing-prompt">
      <span class="prompt-icon">🧘</span>
      <p class="prompt-text">¿Cómo comenzar la práctica?</p>
      <a href="/practica_guiada" class="prompt-btn">Ver instructivo</a>
    </div>
  </div>
</Layout>

<style>
  .landing-hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    padding: 2rem 1rem;
    text-align: center;
    gap: 2rem;
  }

  .landing-title {
    font-size: clamp(2rem, 10vw, 3.5rem);
    font-weight: 700;
    margin: 0;
    background: linear-gradient(135deg, #fefefe 0%, #a5b4fc 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1.2;
  }

  .landing-subtitle {
    font-size: clamp(1rem, 4vw, 1.25rem);
    font-weight: 500;
    margin: 0;
    color: #9ca3af;
  }

  .landing-prompt {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 2rem;
    background: rgba(22, 22, 42, 0.8);
    border: 1px solid rgba(139, 92, 246, 0.3);
    border-radius: 20px;
    max-width: 320px;
    animation: fadeIn 0.6s ease-out;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .prompt-icon {
    font-size: 2.5rem;
  }

  .prompt-text {
    font-size: 1.1rem;
    font-weight: 600;
    color: #e5e7eb;
    margin: 0;
  }

  .prompt-btn {
    display: inline-block;
    padding: 0.75rem 2rem;
    background: linear-gradient(135deg, #8b5cf6, #6366f1);
    color: white;
    border-radius: 25px;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .prompt-btn:hover {
    transform: scale(1.05);
    box-shadow: 0 6px 20px rgba(139, 92, 246, 0.4);
  }
</style>