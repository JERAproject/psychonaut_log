---
import JournalList from "../components/JournalList.astro";
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Bitácora | PsychonautLog" 
  description="Explora tu bitácora de prácticas psiconáuticas. Revisa tus entradas, insights y reflexiones."
>
  <main class="journal-page">
    <header class="page-header">
      <h1>Bitácora</h1>
      <p class="subtitle">Tu registro de prácticas y descubrimientos</p>
    </header>
    <JournalList />
  </main>
</Layout>

<style>
  .journal-page {
    padding: 1.5rem 1rem;
    padding-left: max(1rem, env(safe-area-inset-left));
    padding-right: max(1rem, env(safe-area-inset-right));
    max-width: 900px;
    margin: 0 auto;
    min-height: 100vh;
  }

  @media (min-width: 640px) {
    .journal-page {
      padding: 2rem 1.5rem;
    }
  }

  .page-header {
    text-align: center;
    margin-bottom: 1.5rem;
  }

  @media (min-width: 640px) {
    .page-header {
      margin-bottom: 2.5rem;
    }
  }

  .page-header h1 {
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    font-weight: 700;
    margin: 0 0 0.5rem;
    background: linear-gradient(135deg, #fefefe 0%, #a5b4fc 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  @media (min-width: 640px) {
    .page-header h1 {
      margin-bottom: 0.75rem;
    }
  }

  .subtitle {
    color: #6b7280;
    font-size: clamp(0.875rem, 2.5vw, 1.1rem);
    margin: 0;
  }
</style>