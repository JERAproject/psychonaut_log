---
import Tecnicas from "../components/Tecnicas.astro";
import JournalList from "../components/JournalList.astro";
import Layout from '../layouts/Layout.astro';
---
<Layout 
  title="Journal | PsychonautLog" 
  description="Explora tu bitácora de prácticas psiconáuticas. Revisa tus entradas, insights y reflexiones de meditación, visualización y autoindagación."
>
  <main class="journal-page">
    <header class="page-header">
      <h1>Journal Psiconáutico</h1>
      <p>Explora tu registro de prácticas y descubrimientos</p>
    </header>
    <Tecnicas />
    <div id="entradas-guardadas">
      <JournalList />
    </div>
  </main>
</Layout>

<style>
  .journal-page {
    padding: 2rem 1rem;
    max-width: 900px;
    margin: 0 auto;
  }

  .page-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .page-header h1 {
    font-size: 2rem;
    margin: 0 0 0.5rem;
    color: #fefefe;
  }

  .page-header p {
    color: #888;
    margin: 0;
  }

  @media (max-width: 640px) {
    .journal-page {
      padding: 1rem;
    }
  }
</style>