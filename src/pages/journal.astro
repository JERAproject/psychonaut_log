---
import Layout from '../layouts/Layout.astro';
import JournalPage from '../components/JournalPage.jsx';
---

<Layout 
  title="Bitácora | PsychonautLog" 
  description="Explora tu bitácora de prácticas psiconáuticas. Revisa tus entradas, insights y reflexiones."
>
  <main class="journal-page">
    <header class="page-header">
      <h1>Bitácora</h1>
      <p class="subtitle">Tu registro de prácticas y descubrimientos</p>
    </header>
    <div class="journal-wrapper">
      <JournalPage client:load />
    </div>
  </main>
</Layout>

<style>
  .journal-page {
    padding: 1.5rem 1rem;
    padding-left: max(1rem, env(safe-area-inset-left));
    padding-right: max(1rem, env(safe-area-inset-right));
    min-height: 100vh;
    background: #050505;
    color: #fff;
  }

  @media (min-width: 640px) {
    .journal-page {
      padding: 2rem 1.5rem;
    }
  }

  .page-header {
    text-align: center;
    margin-bottom: 1.5rem;
  }

  @media (min-width: 640px) {
    .page-header {
      margin-bottom: 2rem;
    }
  }

  .page-header h1 {
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    font-weight: 700;
    margin: 0 0 0.5rem;
    background: linear-gradient(135deg, #fefefe 0%, #a5b4fc 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .subtitle {
    color: rgba(255,255,255,0.55);
    font-size: clamp(0.9rem, 2vw, 1.1rem);
    margin: 0;
  }

  .journal-wrapper {
    width: 100%;
  }
</style>