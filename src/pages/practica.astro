---
import JournalList from "../components/JournalList.astro";
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Práctica | PsychonautLog" 
  description="Registra y explora tus sesiones de práctica psiconáutica."
>
  <main class="practica-page">
    <header class="page-header">
      <h1>Práctica</h1>
      <p class="subtitle">Registra y explora tus sesiones de exploración fenomenológica</p>
    </header>

    <div class="tabs">
      <button class="tab-btn active" data-tab="nueva">Nueva Entrada</button>
      <button class="tab-btn" data-tab="bitacora">Bitácora</button>
    </div>

    <section id="nueva-tab" class="tab-content active">
      <div class="state-selector">
        <label class="state-label">Estado de la sesión:</label>
        <div class="state-options">
          <label class="state-option state-basal">
            <input type="radio" name="session_state" value="basal" checked />
            <span class="state-indicator"></span>
            <span class="state-text">Basal</span>
          </label>
          <label class="state-option state-altered">
            <input type="radio" name="session_state" value="altered" />
            <span class="state-indicator"></span>
            <span class="state-text">Alterado</span>
          </label>
        </div>
      </div>

      <form id="journal-form" class="data-form" aria-label="Formulario de entrada de bitácora">

        <!-- ═══ STANDARD FORM FIELDS ═══ -->
        <div id="standard-form-fields">
          <fieldset>
            <legend>Metadatos de la Sesión</legend>
            <div class="grid">
              <label>
                Fecha
                <input type="date" name="fecha" required aria-required="true" value={new Date().toISOString().split('T')[0]} />
              </label>
              <label>
                Hora
                <input type="time" name="hora" required aria-required="true" value={(() => { const d = new Date(); return `${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`; })()} />
              </label>
              <label>
                Duración (min)
                <input type="number" name="duracion" min="1" placeholder="Ej: 20" required aria-required="true" />
              </label>
            </div>

            <div class="tipo-practica-row">
              <label>
                Tipo de Práctica
                <select name="tipo_practica" id="tipo-practica-select" required aria-required="true">
                  <option value="">Cargando...</option>
                </select>
              </label>
              <button type="button" id="manage-practices-btn" class="btn-icon-small" title="Gestionar prácticas" aria-label="Gestionar prácticas">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
              </button>
            </div>
          </fieldset>

          <fieldset>
            <legend>Fenomenología y Estado</legend>
            <label>
              Estado Previo a la Práctica
              <input type="text" name="estado_previo" placeholder="Ej: Dispersión analítica, fatiga..." required aria-required="true" />
            </label>

            <div class="sliders-container">
              <p class="sliders-hint">Opcional pero útil para seguir patrones</p>
              
              <div class="slider-group">
                <div class="slider-header">
                  <span class="slider-title">ENERGY (Pre) <span class="info-icon" data-tooltip="energy" onclick="showTooltip('energy', event)" role="button" tabindex="0" aria-label="Información sobre ENERGY"><svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="1.5"/><text x="12" y="15" font-family="sans-serif" font-size="12" font-weight="bold" fill="currentColor" text-anchor="middle">i</text></svg></span></span>
                  <span class="slider-value" id="energy-pre-value">—</span>
                </div>
                <input type="range" name="energy_pre" min="-5" max="5" step="1" class="slider" />
                <div class="slider-labels">
                  <span>bajo</span>
                  <span>alto</span>
                </div>
              </div>

              <div class="slider-group">
                <div class="slider-header">
                  <span class="slider-title">VALENCE (Pre) <span class="info-icon" data-tooltip="valence" onclick="showTooltip('valence', event)" role="button" tabindex="0" aria-label="Información sobre VALENCE"><svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="1.5"/><text x="12" y="15" font-family="sans-serif" font-size="12" font-weight="bold" fill="currentColor" text-anchor="middle">i</text></svg></span></span>
                  <span class="slider-value" id="valence-pre-value">—</span>
                </div>
                <input type="range" name="valence_pre" min="-5" max="5" step="1" class="slider" />
                <div class="slider-labels">
                  <span>dolor</span>
                  <span>placer</span>
                </div>
              </div>
            </div>

            <label>
              Fenomenología Somática (Sensaciones corporales)
              <input type="text" name="fenomenologia_somatica" placeholder="Ej: Fosfenos, presión en entrecejo, tensión en hombros..." required aria-required="true" />
              <span class="helper">Describe lo que observas, no por qué sucede</span>
            </label>
            <label>
              Fenomenología Cognitiva (Pensamientos observados antes de la práctica)
              <textarea name="fenomenologia_cognitiva" rows="4" placeholder="Describe los pensamientos que surgieron antes de la práctica..."></textarea>
              <span class="helper">Describe lo que observas, no por qué sucede</span>
            </label>
            <label>
              Descripción Detallada (lo que experimentaste durante la práctica)
              <textarea name="cuerpo" rows="6" placeholder="Describe el flujo de la experiencia..."></textarea>
            </label>
          </fieldset>

          <fieldset>
            <legend>Análisis e Integración</legend>
            <label>
              Hallazgo Principal
              <input type="text" name="insight" placeholder="¿Qué descubriste hoy sobre mi mente?" />
            </label>
            <label>
              Plan de Integración de los Hallazgos
              <input type="text" name="integracion" placeholder="Acción concreta para el día siguiente puedo aplicar en mi vida diaria?" />
            </label>
            <label>
              Estado Post-Práctica
              <input type="text" name="estado_post" placeholder="Ej: Ecuanimidad, vitalidad..." required aria-required="true" />
            </label>

            <div class="sliders-container">
              <p class="sliders-hint">Opcional pero útil para seguir patrones</p>
              
              <div class="slider-group">
                <div class="slider-header">
                  <span class="slider-title">ENERGY (Post) <span class="info-icon" data-tooltip="energy" onclick="showTooltip('energy', event)" role="button" tabindex="0" aria-label="Información sobre ENERGY"><svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="1.5"/><text x="12" y="15" font-family="sans-serif" font-size="12" font-weight="bold" fill="currentColor" text-anchor="middle">i</text></svg></span></span>
                  <span class="slider-value" id="energy-post-value">—</span>
                </div>
                <input type="range" name="energy_post" min="-5" max="5" step="1" class="slider" />
                <div class="slider-labels">
                  <span>bajo</span>
                  <span>alto</span>
                </div>
              </div>

              <div class="slider-group">
                <div class="slider-header">
                  <span class="slider-title">VALENCE (Post) <span class="info-icon" data-tooltip="valence" onclick="showTooltip('valence', event)" role="button" tabindex="0" aria-label="Información sobre VALENCE"><svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="1.5"/><text x="12" y="15" font-family="sans-serif" font-size="12" font-weight="bold" fill="currentColor" text-anchor="middle">i</text></svg></span></span>
                  <span class="slider-value" id="valence-post-value">—</span>
                </div>
                <input type="range" name="valence_post" min="-5" max="5" step="1" class="slider" />
                <div class="slider-labels">
                  <span>dolor</span>
                  <span>placer</span>
                </div>
              </div>
            </div>
          </fieldset>
        </div>

        <!-- ═══ BIENESTAR VIEW (shown when tipo_practica = diagrama_de_bienestar) ═══ -->
        <div id="bienestar-view" class="hidden">
          <fieldset class="bienestar-fieldset">
            <legend>Diagrama de Bienestar</legend>
            <p class="bienestar-desc">Evalúa tu nivel de bienestar en las siguientes áreas. Cada dimensión tiene una escala del 1 al 5 con las siguientes referencias:</p>

            <div class="bienestar-levels-guide">
              <div class="level-card level-1">
                <span class="level-num">1</span>
                <span class="level-label">Casi no tengo en mi vida</span>
              </div>
              <div class="level-card level-2">
                <span class="level-num">2</span>
                <span class="level-label">Tengo poco</span>
              </div>
              <div class="level-card level-3">
                <span class="level-num">3</span>
                <span class="level-label">Tengo moderadamente</span>
              </div>
              <div class="level-card level-4">
                <span class="level-num">4</span>
                <span class="level-label">Estoy conforme con este aspecto</span>
              </div>
              <div class="level-card level-5">
                <span class="level-num">5</span>
                <span class="level-label">Siento que soy fuerte en este elemento</span>
              </div>
            </div>

            <div id="bienestar-sliders">
              <!-- Logros -->
              <div class="slider-group bienestar-slider-group">
                <div class="slider-header">
                  <span class="slider-title bienestar-slider-title">
                    <span class="bienestar-axis-icon">🏆</span>
                    Logros
                  </span>
                  <span class="slider-value bienestar-slider-value" id="bienestar-logros-value">—</span>
                </div>
                <input type="range" name="bienestar_logros" min="1" max="5" step="1" class="slider bienestar-slider" />
                <div class="bienestar-level-marks">
                  <span>1</span><span>2</span><span>3</span><span>4</span><span>5</span>
                </div>
              </div>

              <!-- Relaciones interpersonales -->
              <div class="slider-group bienestar-slider-group">
                <div class="slider-header">
                  <span class="slider-title bienestar-slider-title">
                    <span class="bienestar-axis-icon">🤝</span>
                    Relaciones interpersonales
                  </span>
                  <span class="slider-value bienestar-slider-value" id="bienestar-relaciones-value">—</span>
                </div>
                <input type="range" name="bienestar_relaciones" min="1" max="5" step="1" class="slider bienestar-slider" />
                <div class="bienestar-level-marks">
                  <span>1</span><span>2</span><span>3</span><span>4</span><span>5</span>
                </div>
              </div>

              <!-- Sentido vital -->
              <div class="slider-group bienestar-slider-group">
                <div class="slider-header">
                  <span class="slider-title bienestar-slider-title">
                    <span class="bienestar-axis-icon">🎯</span>
                    Sentido vital
                  </span>
                  <span class="slider-value bienestar-slider-value" id="bienestar-sentido-value">—</span>
                </div>
                <input type="range" name="bienestar_sentido" min="1" max="5" step="1" class="slider bienestar-slider" />
                <div class="bienestar-level-marks">
                  <span>1</span><span>2</span><span>3</span><span>4</span><span>5</span>
                </div>
              </div>

              <!-- Emociones agradables -->
              <div class="slider-group bienestar-slider-group">
                <div class="slider-header">
                  <span class="slider-title bienestar-slider-title">
                    <span class="bienestar-axis-icon">😊</span>
                    Emociones agradables
                  </span>
                  <span class="slider-value bienestar-slider-value" id="bienestar-emociones-value">—</span>
                </div>
                <input type="range" name="bienestar_emociones" min="1" max="5" step="1" class="slider bienestar-slider" />
                <div class="bienestar-level-marks">
                  <span>1</span><span>2</span><span>3</span><span>4</span><span>5</span>
                </div>
              </div>

              <!-- Entrega (flow) -->
              <div class="slider-group bienestar-slider-group">
                <div class="slider-header">
                  <span class="slider-title bienestar-slider-title">
                    <span class="bienestar-axis-icon">🌀</span>
                    Entrega (flow)
                  </span>
                  <span class="slider-value bienestar-slider-value" id="bienestar-entrega-value">—</span>
                </div>
                <input type="range" name="bienestar_entrega" min="1" max="5" step="1" class="slider bienestar-slider" />
                <div class="bienestar-level-marks">
                  <span>1</span><span>2</span><span>3</span><span>4</span><span>5</span>
                </div>
              </div>
            </div>

            <div class="bienestar-legend">
              <span class="bienestar-legend-item"><span class="bienestar-dot" style="background:#ef4444"></span>1 — Casi no tengo en mi vida</span>
              <span class="bienestar-legend-item"><span class="bienestar-dot" style="background:#f59e0b"></span>2 — Tengo poco</span>
              <span class="bienestar-legend-item"><span class="bienestar-dot" style="background:#eab308"></span>3 — Tengo moderadamente</span>
              <span class="bienestar-legend-item"><span class="bienestar-dot" style="background:#22c55e"></span>4 — Estoy conforme con este aspecto de mi vida</span>
              <span class="bienestar-legend-item"><span class="bienestar-dot" style="background:#8b5cf6"></span>5 — Siento que soy fuerte en este elemento</span>
            </div>
          </fieldset>
        </div>

        <button type="submit" class="submit-btn">Guardar en Bitácora</button>
      </form>
    </section>

    <div id="substance-modal" class="modal-overlay hidden" role="dialog" aria-modal="true">
      <div class="modal substance-modal">
        <div class="modal-hd">
          <h3>Estado Alterado</h3>
          <button id="close-substance-modal" class="mc" aria-label="Cerrar">&times;</button>
        </div>
        <div class="substance-form-wrap">
          <p class="substance-desc">Registra la sustancia consumida para esta sesión</p>
          <form id="substance-form" class="sf">
            <label>
              Sustancia
              <input type="text" name="sustancia" id="sustancia-input" placeholder="Ej: Psilocibina u otra sustancia" required />
            </label>
            <label>
              Dosis (opcional)
              <input type="text" name="dosis" id="dosis-input" placeholder="Ej: 150μg, 2g, 100mg..." />
            </label>
            <div class="substance-actions">
              <button type="button" id="skip-substance-btn" class="btn-text">Omitir</button>
              <button type="submit" class="btn-purple">Guardar</button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <section id="bitacora-tab" class="tab-content">
      <JournalList />
    </section>
  </main>
</Layout>

<div id="practice-modal" class="modal-overlay hidden" role="dialog" aria-modal="true">
  <div class="modal practice-modal">
    <div class="modal-hd">
      <h3>Gestionar Prácticas</h3>
      <button id="close-practice-modal" class="mc" aria-label="Cerrar">&times;</button>
    </div>
    <div class="add-practice-form-wrap">
      <h4>Nueva práctica</h4>
      <form id="add-practice-form" class="apf">
        <input type="text" name="slug" placeholder="slug (ej: respiracion_circular)" required maxlength="40" />
        <input type="text" name="label" placeholder="Nombre visible (ej: Respiración Circular)" required maxlength="60" />
        <button type="submit" class="btn-blue-sm">Agregar</button>
        <div id="add-practice-err" class="ferr"></div>
        <div id="add-practice-succ" class="fsucc"></div>
      </form>
    </div>
    <div class="practice-list-wrap">
      <h4>Prácticas disponibles</h4>
      <div id="practice-list"></div>
      <div id="practice-list-err" class="ferr"></div>
    </div>
  </div>
</div>

<script>
  // Función global para mostrar tooltips con debug
  window.showTooltip = function(type, event) {
    console.log('showTooltip llamado - type:', type, 'event:', event);
    
    if (event) {
      event.preventDefault();
      event.stopPropagation();
    }
    
    const tooltips = {
      energy: "ENERGY: Representa el nivel de activación/alerta. Desliza a la izquierda para estados de baja energía (relajación, sueño) y a la derecha para alta energía (excitación, alerte).",
      valence: "VALENCE: Escala de equilibrio entre estados de dolor y placer. Desliza hacia la izquierda indicando estados de dolor o disconfort más bajos y hacia la derecha indicando estados de placer o bienestar más altos."
    };
    
    const text = tooltips[type] || '';
    console.log('Texto del tooltip:', text);
    
    // Cerrar popup existente
    const existing = document.querySelector('.info-popup');
    if (existing) {
      console.log('Popup existente encontrado, removiendo');
      existing.remove();
    }
    
    const popup = document.createElement('div');
    popup.className = 'info-popup';
    popup.setAttribute('role', 'dialog');
    popup.setAttribute('aria-modal', 'true');
    popup.setAttribute('aria-label', `Información sobre ${type}`);
    const infoIcon = document.querySelector(`.info-icon[data-tooltip="${type}"]`);
    infoIcon?.setAttribute('aria-expanded', 'true');
    popup.style.cssText = 'position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);background:#1a1a2e;border:1px solid #8b5cf6;border-radius:12px;padding:1.25rem;max-width:90%;width:320px;z-index:9999;box-shadow:0 10px 40px rgba(0,0,0,0.5);';
    popup.innerHTML = '<p id="popup-desc" style="color:#e5e7eb;font-size:0.9rem;line-height:1.5;margin:0;padding-right:1.5rem;">' + text + '</p><button style="position:absolute;top:0.5rem;right:0.5rem;background:transparent;border:none;color:#9ca3af;font-size:1.25rem;cursor:pointer;width:1.5rem;height:1.5rem;" class="popup-close" aria-label="Cerrar">×</button>';
    document.body.appendChild(popup);
    console.log('Popup creado y agregado al body');
    
    const closeBtn = popup.querySelector('.popup-close') as HTMLButtonElement;
    closeBtn?.addEventListener('click', function() { 
      console.log('Cerrando popup'); 
      popup.remove(); 
      document.querySelector(`.info-icon[data-tooltip="${type}"]`)?.setAttribute('aria-expanded', 'false');
    });
    
    popup.addEventListener('keydown', (ev) => {
      if (ev.key === 'Escape') {
        popup.remove();
        document.querySelector(`.info-icon[data-tooltip="${type}"]`)?.setAttribute('aria-expanded', 'false');
      }
    });
    
    popup.addEventListener('click', function(ev) {
      if (ev.target === popup) {
        console.log('Click fuera del contenido del popup');
        popup.remove();
        document.querySelector(`.info-icon[data-tooltip="${type}"]`)?.setAttribute('aria-expanded', 'false');
      }
    });
    
    console.log('Popup debería ser visible ahora');
  };

  // ── Practices CRUD ──────────────────────────────────────
  const TOKEN_KEY = 'psy_token';
  function getApiBase(): string {
    return '';
  }
  function getToken(): string | null { return localStorage.getItem(TOKEN_KEY); }

  async function apiFetch(path: string, opts: RequestInit = {}) {
    const token = getToken();
    return fetch(`${getApiBase()}${path}`, {
      ...opts,
      headers: { 'Content-Type': 'application/json', ...(token ? { Authorization: `Bearer ${token}` } : {}), ...opts.headers }
    });
  }

  async function loadPractices() {
    const select = document.getElementById('tipo-practica-select') as HTMLSelectElement;
    try {
      const res = await apiFetch('/api/practices');
      if (!res.ok) { select.innerHTML = '<option value="">Error cargando</option>'; return; }
      const practices: { slug: string; label: string }[] = await res.json();
      select.innerHTML = '<option value="">Selecciona una práctica</option>' +
        practices.map(p => `<option value="${p.slug}">${p.label}</option>`).join('');
    } catch {
      select.innerHTML = '<option value="">Error de conexión</option>';
    }
  }

  function openPracticeModal() {
    const overlay = document.getElementById('practice-modal')!;
    overlay.classList.remove('hidden');
    loadPracticeList();
  }

  async function loadPracticeList() {
    const list = document.getElementById('practice-list')!;
    const listErr = document.getElementById('practice-list-err')!;
    listErr.textContent = '';
    try {
      const res = await apiFetch('/api/practices');
      const practices: { slug: string; label: string }[] = await res.ok ? await res.json() : [];
      list.innerHTML = practices.map(p => `
        <div class="practice-item">
          <span class="practice-label">${p.label}</span>
          <span class="practice-slug">${p.slug}</span>
          <button type="button" class="btn-del-practice" data-slug="${p.slug}" aria-label="Eliminar práctica ${p.label}">✕</button>
        </div>
      `).join('');
      list.querySelectorAll('.btn-del-practice').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          const slug = (e.currentTarget as HTMLButtonElement).dataset.slug!;
          if (!confirm(`¿Eliminar la práctica "${slug}"?`)) return;
          const res = await apiFetch(`/api/practices/${slug}`, { method: 'DELETE' });
          if (res.ok) { loadPracticeList(); loadPractices(); }
          else { const d = await res.json(); listErr.textContent = d.error || 'Error eliminando'; }
        });
      });
    } catch { listErr.textContent = 'Error de conexión'; }
  }

  document.getElementById('manage-practices-btn')?.addEventListener('click', openPracticeModal);
  document.getElementById('close-practice-modal')?.addEventListener('click', () => document.getElementById('practice-modal')?.classList.add('hidden'));
  document.getElementById('practice-modal')?.addEventListener('click', (e) => { if (e.target === e.currentTarget) e.currentTarget.classList.add('hidden'); });

  document.getElementById('add-practice-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const fd = new FormData(form);
    const slug = fd.get('slug') as string;
    const label = fd.get('label') as string;
    const errEl = document.getElementById('add-practice-err')!;
    const succEl = document.getElementById('add-practice-succ')!;
    errEl.textContent = ''; succEl.textContent = '';
    const res = await apiFetch('/api/practices', { method: 'POST', body: JSON.stringify({ slug, label }) });
    const d = await res.json();
    if (!res.ok) { errEl.textContent = d.error || 'Error'; return; }
    succEl.textContent = `Práctica "${label}" creada`;
    form.reset();
    loadPracticeList();
    loadPractices();
  });

  loadPractices();

  // ── Auto-save form to localStorage ──────────────────────
  const form = document.getElementById("journal-form") as HTMLFormElement | null;
  const DRAFT_KEY = 'psy_journal_draft';
  const draftInputs = ['fecha', 'hora', 'duracion', 'tipo_practica', 'estado_previo', 'fenomenologia_somatica', 'fenomenologia_cognitiva', 'cuerpo', 'insight', 'integracion', 'estado_post'];
  const draftSliders = ['energy_pre', 'valence_pre', 'energy_post', 'valence_post'];
  const draftBienestar = ['bienestar_logros', 'bienestar_relaciones', 'bienestar_sentido', 'bienestar_emociones', 'bienestar_entrega'];

  function saveDraft() {
    const data: Record<string, any> = {};
    draftInputs.forEach(name => {
      const el = form?.querySelector(`[name="${name}"]`) as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
      if (el) data[name] = el.value;
    });
    draftSliders.forEach(name => {
      const el = form?.querySelector(`[name="${name}"]`) as HTMLInputElement;
      if (el) data[name] = el.value;
    });
    draftBienestar.forEach(name => {
      const el = form?.querySelector(`[name="${name}"]`) as HTMLInputElement;
      if (el) data[name] = el.value;
    });
    const tipoSelect = document.getElementById('tipo-practica-select') as HTMLSelectElement;
    if (tipoSelect) data.bienestar_enabled = tipoSelect.value === 'diagrama_de_bienestar';
    const stateRadio = document.querySelector('input[name="session_state"]:checked') as HTMLInputElement;
    if (stateRadio) data.session_state = stateRadio.value;
    if (currentSustancia) data.sustancia = currentSustancia;
    if (currentDosis) data.dosis = currentDosis;
    localStorage.setItem(DRAFT_KEY, JSON.stringify(data));
  }

  function restoreDraft() {
    const saved = localStorage.getItem(DRAFT_KEY);
    if (!saved) return;
    try {
      const data = JSON.parse(saved);
      draftInputs.forEach(name => {
        const el = form?.querySelector(`[name="${name}"]`) as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
        if (el && data[name]) el.value = data[name];
      });
      draftSliders.forEach(name => {
        const el = form?.querySelector(`[name="${name}"]`) as HTMLInputElement;
        if (el && data[name]) {
          el.value = data[name];
          const valueDisplay = document.getElementById(`${name}-value`);
          if (valueDisplay) valueDisplay.textContent = data[name] !== '' ? data[name] : '—';
        }
      });
      if (data.bienestar_enabled) {
        const select = document.getElementById('tipo-practica-select') as HTMLSelectElement;
        if (select && select.value !== 'diagrama_de_bienestar') {
          select.value = 'diagrama_de_bienestar';
          toggleBienestarView(true);
        }
        draftBienestar.forEach(name => {
          const el = form?.querySelector(`[name="${name}"]`) as HTMLInputElement;
          if (el && data[name]) {
            el.value = data[name];
            const valueDisplay = document.getElementById(`${name.replace(/_/g, '-')}-value`);
            if (valueDisplay) valueDisplay.textContent = data[name] !== '' ? data[name] : '—';
          }
        });
      }
      if (data.session_state === 'altered') {
        const alteredRadio = document.querySelector('input[name="session_state"][value="altered"]') as HTMLInputElement;
        if (alteredRadio) alteredRadio.checked = true;
        if (data.sustancia) {
          currentSustancia = data.sustancia;
          currentDosis = data.dosis || '';
          applyAlteredMode();
        }
      }
    } catch {}
  }

  function clearDraft() {
    localStorage.removeItem(DRAFT_KEY);
  }

  function resetFormDefaults() {
    const fechaInput = form?.querySelector('[name="fecha"]') as HTMLInputElement;
    const horaInput = form?.querySelector('[name="hora"]') as HTMLInputElement;
    if (fechaInput) {
      fechaInput.value = new Date().toISOString().split('T')[0];
    }
    if (horaInput) {
      const d = new Date();
      horaInput.value = `${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;
    }
    const sliders = form?.querySelectorAll('input[type="range"]') as NodeListOf<HTMLInputElement>;
    sliders?.forEach(slider => {
      const valueDisplay = document.getElementById(`${slider.name}-value`);
      if (valueDisplay) valueDisplay.textContent = '—';
    });
    const select = document.getElementById('tipo-practica-select') as HTMLSelectElement;
    if (select) {
      select.value = '';
      toggleBienestarView(false);
    }
  }

  if (form) {
    form.querySelectorAll('input, select, textarea').forEach(el => {
      el.addEventListener('input', saveDraft);
      el.addEventListener('change', saveDraft);
    });
    const stateRadiosList = form.querySelectorAll('input[name="session_state"]');
    stateRadiosList.forEach(r => r.addEventListener('change', saveDraft));
  }

  restoreDraft();

  // ── Bienestar view toggle (via tipo_practica select) ────
  const bienestarRequiredFields = ['duracion', 'estado_previo', 'fenomenologia_somatica', 'estado_post'];

  function toggleBienestarView(enabled: boolean) {
    const standardFields = document.getElementById('standard-form-fields') as HTMLDivElement;
    const bienestarView = document.getElementById('bienestar-view') as HTMLDivElement;
    if (!standardFields || !bienestarView) return;
    if (enabled) {
      standardFields.classList.add('hidden');
      bienestarView.classList.remove('hidden');
      bienestarRequiredFields.forEach(name => {
        const el = form?.querySelector(`[name="${name}"]`) as HTMLInputElement;
        if (el) el.required = false;
      });
    } else {
      standardFields.classList.remove('hidden');
      bienestarView.classList.add('hidden');
      bienestarRequiredFields.forEach(name => {
        const el = form?.querySelector(`[name="${name}"]`) as HTMLInputElement;
        if (el) el.required = true;
      });
    }
  }

  const tipoSelect = document.getElementById('tipo-practica-select') as HTMLSelectElement;
  tipoSelect?.addEventListener('change', () => {
    toggleBienestarView(tipoSelect.value === 'diagrama_de_bienestar');
    saveDraft();
  });

  // ── Update bienestar slider values ──────────────────────
  draftBienestar.forEach(name => {
    const el = form?.querySelector(`[name="${name}"]`) as HTMLInputElement;
    el?.addEventListener('input', () => {
      const valueDisplay = document.getElementById(`${name.replace(/_/g, '-')}-value`);
      if (valueDisplay) valueDisplay.textContent = el.value || '—';
      saveDraft();
    });
  });

  // Estado alterado - mostrar modal y cambiar colores
  const stateRadios = document.querySelectorAll('input[name="session_state"]') as NodeListOf<HTMLInputElement>;
  const page = document.querySelector('.practica-page') as HTMLElement;
  const substanceModal = document.getElementById('substance-modal') as HTMLDivElement;
  const substanceForm = document.getElementById('substance-form') as HTMLFormElement;
  const skipBtn = document.getElementById('skip-substance-btn') as HTMLButtonElement;
  const closeSubstanceBtn = document.getElementById('close-substance-modal') as HTMLButtonElement;
  
  let currentSustancia = '';
  let currentDosis = '';

  stateRadios.forEach(radio => {
    radio.addEventListener('change', () => {
      if (radio.value === 'altered') {
        substanceModal.classList.remove('hidden');
      } else {
        page.classList.remove('altered-mode');
        currentSustancia = '';
        currentDosis = '';
      }
    });
  });

  function applyAlteredMode() {
    page.classList.add('altered-mode');
    const sustanciaInput = document.getElementById('sustancia-input') as HTMLInputElement;
    const dosisInput = document.getElementById('dosis-input') as HTMLInputElement;
    if (sustanciaInput) sustanciaInput.value = currentSustancia;
    if (dosisInput) dosisInput.value = currentDosis;
  }

  substanceForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const fd = new FormData(substanceForm);
    currentSustancia = fd.get('sustancia') as string;
    currentDosis = fd.get('dosis') as string;
    substanceModal.classList.add('hidden');
    applyAlteredMode();
  });

  skipBtn?.addEventListener('click', () => {
    substanceModal.classList.add('hidden');
    const basalRadio = document.querySelector('input[name="session_state"][value="basal"]') as HTMLInputElement;
    if (basalRadio) basalRadio.checked = true;
    page.classList.remove('altered-mode');
  });

  closeSubstanceBtn?.addEventListener('click', () => {
    substanceModal.classList.add('hidden');
    const basalRadio = document.querySelector('input[name="session_state"][value="basal"]') as HTMLInputElement;
    if (basalRadio) basalRadio.checked = true;
    page.classList.remove('altered-mode');
  });

  substanceModal?.addEventListener('click', (e) => {
    if (e.target === e.currentTarget) {
      e.currentTarget.classList.add('hidden');
      const basalRadio = document.querySelector('input[name="session_state"][value="basal"]') as HTMLInputElement;
      if (basalRadio) basalRadio.checked = true;
      page.classList.remove('altered-mode');
    }
  });

  const btn = form?.querySelector(".submit-btn") as HTMLButtonElement;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    btn.textContent = "Guardando...";
    btn.disabled = true;

    const formData = new FormData(form);
    
    // Get slider values - convert empty to null
    const sliderNames = ["energy_pre", "valence_pre", "energy_post", "valence_post"];
    const bienestarNames = ["bienestar_logros", "bienestar_relaciones", "bienestar_sentido", "bienestar_emociones", "bienestar_entrega"];
    const payload: Record<string, any> = {};
    
    formData.forEach((value, key) => {
      if (sliderNames.includes(key as string) && value === "") {
        payload[key] = null;
      } else {
        payload[key] = value;
      }
    });

    // Include bienestar fields if diagrama_de_bienestar selected
    const tipoSelect = form?.querySelector('[name="tipo_practica"]') as HTMLSelectElement;
    if (tipoSelect?.value === 'diagrama_de_bienestar') {
      bienestarNames.forEach(name => {
        const el = form?.querySelector(`[name="${name}"]`) as HTMLInputElement;
        payload[name] = el?.value || null;
      });
      // Auto-fill required backend fields with sentinels
      payload.estado_previo = '(auto) Diagrama de Bienestar';
      payload.fenomenologia_somatica = '(auto) Diagrama de Bienestar';
      payload.estado_post = '(auto) Diagrama de Bienestar';
      payload.duracion = payload.duracion || '15';
    }

    console.log('[DEBUG] Submit payload:', JSON.stringify(payload, null, 2));

    // Agregar datos de estado alterado
    const stateRadio = document.querySelector('input[name="session_state"]:checked') as HTMLInputElement;
    if (stateRadio?.value === 'altered') {
      payload.session_state = 'altered';
      if (currentSustancia) {
        payload.sustancia = currentSustancia;
        if (currentDosis) payload.dosis = currentDosis;
      }
    } else {
      payload.session_state = 'basal';
    }

    try {
      const token = localStorage.getItem("psy_token");
      const headers: Record<string, string> = { "Content-Type": "application/json" };
      if (token) headers["Authorization"] = `Bearer ${token}`;

      const res = await fetch("/api/journal", {
        method: "POST",
        headers,
        body: JSON.stringify(payload),
      });

      const data = await res.json().catch(() => null);

      if (res.status === 401) {
        showToast("Inicia sesion para guardar", "error");
        document.getElementById("login-btn")?.click();
        return;
      }

      console.log('[DEBUG] Submit response:', res.status, JSON.stringify(data));
      if (res.ok && data?.ok) {
        showToast("Entrada guardada correctamente", "success");
        clearDraft();
        resetFormDefaults();
        form.reset();
        // Reset altered state
        page.classList.remove('altered-mode');
        currentSustancia = '';
        currentDosis = '';
        const basalRadio = document.querySelector('input[name="session_state"][value="basal"]') as HTMLInputElement;
        if (basalRadio) basalRadio.checked = true;
        // Dispatch event with saved entry data for pop-up
        window.dispatchEvent(new CustomEvent("journal-updated", {
          detail: {
            savedEntry: {
              id: data.entry?.id || Date.now(),
              fecha: payload.fecha,
              hora: payload.hora,
              tipo_practica: payload.tipo_practica,
              insight: payload.insight,
            }
          }
        }));
        // Reset slider displays
        sliders.forEach((slider) => {
          const target = slider as HTMLInputElement;
          const valueDisplay = document.getElementById(`${target.name}-value`);
          if (valueDisplay) valueDisplay.textContent = "—";
        });
        // Refresh visualization
        loadVisualization();
      } else {
        showToast(data?.error || "Error al guardar", "error");
      }
    } catch {
      showToast("Error de conexión", "error");
    } finally {
      btn.textContent = "Guardar en Bitácora";
      btn.disabled = false;
    }
  });

  function showToast(message: string, type: "success" | "error") {
    const existing = document.querySelector(".toast");
    existing?.remove();

    const toast = document.createElement("div");
    toast.className = `toast toast-${type}`;
    toast.textContent = message;
    document.body.appendChild(toast);

    requestAnimationFrame(() => toast.classList.add("toast-visible"));

    setTimeout(() => {
      toast.classList.remove("toast-visible");
      setTimeout(() => toast.remove(), 300);
    }, 3000);
  }
</script>

