---
import Layout from "../layouts/Layout.astro";
import HabitDashboard from "../components/HabitDashboard.jsx";
---

<Layout>
<section class="stats-page">
  <div class="hero">
      <h1>Habit Tracker</h1>
      <p>Registrar, visualizar y analizar consistencia.</p>
  </div>

  <HabitDashboard client:load />
</section>
</Layout>

<style>
  .stats-page {
    max-width: 1200px;
    margin: auto;
    padding: 1.5rem 1rem;
  }

  .hero {
    margin-bottom: 1.5rem;
    text-align: center;
  }

  .hero h1 {
    font-size: 2rem;
    margin: 0 0 0.5rem;
    background: linear-gradient(135deg, #fefefe 0%, #a5b4fc 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero p {
    color: #6b7280;
    font-size: 1rem;
    margin: 0;
  }

  @media (min-width: 640px) {
    .stats-page {
      padding: 2rem 1.5rem;
    }
    .hero h1 {
      font-size: 2.5rem;
    }
  }

  @media (min-width: 768px) {
    .stats-page {
      padding: 3rem 2rem;
    }
    .hero h1 {
      font-size: 3rem;
    }
  }
</style>