---
import Layout from "../layouts/Layout.astro";
import HabitDashboard from "../components/HabitDashboard.jsx";
---

<Layout>
<section class="stats-page">
  <div class="hero">
      <h1>Habit Tracker</h1>
      <p>Registrar, visualizar y analizar consistencia.</p>
  </div>

  <HabitDashboard client:load />
</section>
</Layout>

<style>
.stats-page{
max-width:1200px;
margin:auto;
padding:3rem 2rem;
}

.hero{
margin-bottom:2rem;
}

.hero h1{
font-size:3rem;
margin-bottom:.5rem;
}

.hero p{
color:#9ca3af;
}
</style>