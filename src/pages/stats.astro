---
import Layout from "../layouts/Layout.astro";
import HabitDashboard from "../components/HabitDashboard.jsx";
---

<Layout>
<section class="stats-page">
  <div class="hero">
      <h1>Habit Tracker</h1>
      <p>Registrar, visualizar y analizar consistencia.</p>
  </div>

  <HabitDashboard client:load />
</section>
</Layout>

<style>
  .stats-page {
    max-width: 1200px;
    margin: auto;
    padding: 1.5rem 1rem;
    padding-left: max(1rem, env(safe-area-inset-left));
    padding-right: max(1rem, env(safe-area-inset-right));
  }

  .hero {
    margin-bottom: 1.5rem;
    text-align: center;
  }

  .hero h1 {
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    font-weight: 700;
    margin: 0 0 0.5rem;
    background: linear-gradient(135deg, #fefefe 0%, #a5b4fc 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1.2;
  }

  .hero p {
    color: #6b7280;
    font-size: clamp(0.875rem, 2.5vw, 1rem);
    margin: 0;
  }

  @media (min-width: 640px) {
    .stats-page {
      padding: 2rem 1.5rem;
    }
    .hero {
      margin-bottom: 2rem;
    }
  }

  @media (min-width: 768px) {
    .stats-page {
      padding: 2.5rem 2rem;
    }
    .hero h1 {
      font-size: clamp(2rem, 4vw, 3rem);
    }
  }
</style>